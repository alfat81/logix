generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Остальные модели (LegalEntity, Customer, Contract, Order,
// OrderStageCatalog, OrderStageInstance) начинаются с Дорожки Б —
// намеренно не добавлены здесь, Employee/EmployeeSession нужны раньше
// как часть auth-паттерна (А4+А5; исторический план — docs/archive/).
// ^ Исторический комментарий А4 — с Дорожкой Б (Б1) модели ядра
// добавлены ниже (исторический план — docs/archive/). Скоуп Б1: шесть
// моделей ядра заявки; Lead/QuoteOption/документы/подрядчики/брокеры —
// следующих дорожки, поля-ссылки на них сюда не добавлены, чтобы не
// тянуть миграцию-заглушку.

model Employee {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  // DF-02: контактный email для уведомлений (адресат-человек, DF-03).
  // Nullable: поле необязательное, пустота — «email нет», мусор —
  // не сохраняем (isEmail, паттерн resolveEmail company-users).
  email     String?
  password  String // hashPassword() из src/lib/password.ts
  // JSON-массив, не enum — см. раздел 1а LOGISTICS-ROADMAP.md: точный
  // периметр "начальник отдела" ещё не решён, добавление новой роли
  // позже не должно требовать миграции структуры этого поля.
  roles     String   @default("[\"manager\"]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // DF-09: TOTP-секрет в формате base32, зашифрованный AES-256-GCM
  // ключом из env TOTP_ENCRYPTION_KEY (AAD = id сотрудника). Дамп БД
  // без ключа секретов не раскрывает. Nullable: TOTP не включён.
  totpSecret    String?
  // DF-09: момент включения TOTP (null = двухфакторный вход выключен).
  totpEnabledAt DateTime?
  // DF-09: последний принятый шаг TOTP (counter) — повтор кода того же
  // и более раннего шага не принимается (RFC 6238 §5.2).
  totpLastStep  Int?

  sessions       EmployeeSession[]
  // DF-09: одноразовые коды восстановления (хранятся только хешами).
  recoveryCodes  TotpRecoveryCode[]
  // P1-01: назначение ответственным менеджером (обратные связи
  // Lead/Order). Назначение НЕ блокирует деактивацию — проверка
  // isActive живёт в API смены ответственного.
  assignedLeads  Lead[]             @relation("LeadAssignee")
  assignedOrders Order[]            @relation("OrderAssignee")
}

model EmployeeSession {
  id         String   @id @default(cuid())
  employeeId String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([token])
}

// DF-09: одноразовый код восстановления TOTP. В БД — только sha256-хеш
// нормализованного кода (без дефисов, верхний регистр): утечка дампа не
// отдаёт коды. Одноразовость — атомарный updateMany по usedAt: null.
model TotpRecoveryCode {
  id         String    @id @default(cuid())
  employeeId String
  codeHash   String    @unique
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ─── Дорожка Б: ядро заявки (раздел 9 LOGISTICS-ROADMAP.md) ──

model LegalEntity {
  id         String   @id @default(cuid())
  name       String
  // Реквизиты для печатных форм — структура уточняется при генерации
  // документов (роадмап: "не фиксировать точную структуру до реальных форм").
  requisites Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  contracts Contract[]
  orders    Order[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  comment   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // И1: доступ в клиентский кабинет — у ЧЕЛОВЕКА (CustomerUser, DF-02A):
  // логин — телефон пользователя, пароль задаёт менеджер через
  // POST /api/admin/customers/[id]/access (саморегистрации в MVP нет —
  // без SMS-верификации «регистрация на любой номер» открывала бы чужие
  // заявки). Пароль на КОМПАНИИ (Customer.password) удалён contract-
  // миграцией df_03_contract — страховка отката пережила релиз 0.6.4,
  // вход давно идёт через authenticateCustomerLogin (company-users.ts).

  contracts Contract[]
  orders    Order[]
  leads     Lead[]
  sessions  ClientSession[]
  users     CustomerUser[]
}

model Contract {
  id            String    @id @default(cuid())
  legalEntityId String
  customerId    String
  // Сквозной номер рамочного договора (Б4: заявка = "<договор>-<порядковый>",
  // например "17-1"). Int, а не String: выдаётся системой последовательно
  // (max+1 с retry-петлёй на P2002), как number у заказов предыдущего проекта.
  number        Int       @unique
  signedAt      DateTime?
  createdAt     DateTime  @default(now())

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  orders      Order[]

  // Рамочный договор — ровно один на пару клиент+юрлицо (роадмап,
  // разделы 4 и 8.2). Уникальность на уровне БД заодно закрывает гонку
  // двух одновременных «первых заявок» одной пары (см. lib/orders.ts).
  @@unique([customerId, legalEntityId])
  @@index([customerId])
  @@index([legalEntityId])
}

model Order {
  id               String   @id @default(cuid())
  // Составной номер "договор-порядковый" (Б4), например "17-1".
  // Денормализован намеренно (роадмап: "формируется автоматически"):
  // обе части (contract.number, numberInContract) неизменяемы после
  // создания, так что рассинхрона не бывает, а печатные формы заявки
  // всегда имеют готовый номер без сборки через include.
  number           String   @unique
  numberInContract Int
  contractId       String
  legalEntityId    String
  customerId       String
  // Связь с лидом воронки (В1): заявка из конвертации (В4) знает свой
  // источник, «ручные» заявки из Б — leadId null (осознанно допустимо,
  // роадмап). Удаление лида с заявкой невозможно (API В2 откажет 409),
  // а удаление заявки лид не убивает. @unique: один лид → максимум
  // одна заявка.
  leadId           String?  @unique
  // Справочные поля заявки (роадмап, раздел 4/6): Инкотермс — подсказка
  // менеджеру, не управляет логикой; ТН ВЭД — текстовое поле с первого
  // дня как точка расширения Phase 2 (дерево/валидация позже).
  incoterm         String?
  cargoProfile     String   @default("standard") // standard | oversized | dangerous
  hsCode           String?
  // Ручной верхнеуровневый статус (роадмап 8.1: менеджер переводит
  // осознанно, этапы не диктуют его автоматически).
  status           String   @default("calculating") // calculating | confirmed | in_progress | completed | cancelled
  // ─── Ж1: суть заявки ────────────────────────────────────────────
  // Заявка — источник правды после конвертации (принцип переработки):
  // груз и условия копируются с лида СНИМКОМ, дальнейшие правки лида
  // заявку не меняют. cargoInfo — та же форма бланка, что у Lead
  // (хелперы buildLeadCargo/readLeadCargo общие); quoteSnapshot —
  // снимок выбранного варианта расчёта (описание, виды транспорта,
  // цена, срок, ориентир). Оба поля nullable: у ручных заявок (Б3,
  // без лида) они заполняются PATCH'ем (Ж1) или остаются пустыми.
  cargoInfo        Json?
  quoteSnapshot    Json?
  createdAt        DateTime @default(now())
  // P1-01: дата последнего изменения — маркер «заявка без движения»
  // (сортировка «давно без движения», фильтры внимания). @default(now())
  // обязателен: непустая таблица на миграции получает честную точку
  // отсчёта (тот же приём, что updatedAt у Lead — Ж5).
  updatedAt        DateTime @default(now()) @updatedAt
  // P1-01: ответственный менеджер заявки. Конвертация В4 переносит с
  // лида (без ответственного на лиде — тот, кто конвертировал); ручная
  // заявка Б3 — создатель. null = не назначена (например, запрос из
  // кабинета, конвертированный «в общий котёл»). SetNull — как у
  // подрядчика на этапе: API-удаления сотрудника нет, страховка от
  // ручных операций в БД; история назначений живёт в Activity-снимках.
  assignedToId     String?

  // ─── DF-05 «У кого мяч»: вычисляемое ожидание ─────────────────
  // Пишет ТОЛЬКО recomputeWaiting (lib/waiting-db.ts) из emitEvent —
  // роуты эти колонки не задают. kind 'none' = мяча нет (терминальная
  // или нет подходящего правила); NULL = ещё не пересчитано (до
  // backfill). waitingSince сдвигается только при смене kind/reason.
  waitingOnKind String?
  waitingOnId   String?
  waitingReason String?
  waitingSince  DateTime?

  // ─── P1-03: маршрут и груз — те же колонки, что на Lead (см. там) ──
  // Заявка — источник правды после конвертации: копируется с лида
  // снимком (convert), правится PATCH (Ж1) вместе с cargoInfo.
  originCity         String?
  originCountry      String?
  destinationCity    String?
  destinationCountry String?
  transportType      TransportType?
  readyDate          DateTime?
  weightKg           Decimal?       @db.Decimal(12, 3)
  volumeM3           Decimal?       @db.Decimal(10, 3)
  placesCount        Int?

  // ─── DF-17: поля-коды из справочников (рядом со строками, expand) ──
  // Коды берутся из Combobox справочника (IC-16); строковые колонки
  // остаются и денормализуются именем из справочника на записи —
  // отображения/печать/поиск работают без join (принцип снимка).
  // incotermCode — рядом с легаси-текстом incoterm (та же семантика:
  // подсказка менеджеру, логику не управляет до DF-19).
  originCountryCode      String?
  destinationCountryCode String?
  incotermCode           String?
  // DF-19: место условия поставки («Истанбул, TR») — свободный текст
  // рядом с кодом (справочника мест DF-17B ещё нет; при его появлении
  // переезжает на код, expand-паттерн тот же).
  incotermPlace          String?

  contract            Contract             @relation(fields: [contractId], references: [id])
  legalEntity         LegalEntity          @relation(fields: [legalEntityId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id])
  lead                Lead?                @relation(fields: [leadId], references: [id])
  assignee            Employee?            @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  stages              OrderStageInstance[]
  activities          Activity[]
  // Д (роадмап 5а): брокеры заявки — полная видимость сделки целиком,
  // не per-stage (в отличие от подрядчиков). Переносится из LeadBroker
  // при конвертации В4; менеджер может добавить/снять и после.
  brokers             OrderBroker[]
  // Е (роадмап 5): документы заявки — обмен клиент/брокер/менеджер
  // внутри сервиса. Внутренние (isInternal) наружу не отдаются.
  documents           Document[]
  // DF-16: обязательства предоставить разрешительные документы.
  permitRequirements  PermitRequirement[]
  // DF-26 волна 2: проверки ТН ВЭД (PermitCheck, §5.1 SPEC v1.6).
  permitChecks        PermitCheck[]
  // DF-19: расчёты таможенных платежей (история версий)
  customsCalculations CustomsCalculation[]
  // DF-27 волна 2 (D73 §8.6, Р-5): окончательные платежи по ДТ — append-only
  finalCustomsPayments CustomsFinalPayment[]

  @@unique([contractId, numberInContract])
  @@index([status])
  @@index([waitingOnKind, waitingSince])
  @@index([customerId])
  @@index([assignedToId])
  @@index([updatedAt])
  @@index([transportType])
  @@index([originCountry])
  @@index([destinationCountry])
}

model OrderStageCatalog {
  // Справочник типовых этапов — расширяемый (роадмап, раздел 3).
  id          String  @id @default(cuid())
  code        String  @unique // export_pickup | export_customs | loading | transport | import_customs | final_delivery | ...
  name        String
  // Порядок по умолчанию при подстановке/предложении менеджеру.
  order       Int
  // true — подставляется в каждую заявку автоматически, менеджер не
  // может удалить (защита и в API, и в UI).
  isMandatory Boolean @default(false)
}

model OrderStageInstance {
  // Конкретный этап конкретной заявки. Ссылка на каталог — по code
  // (роадмап, раздел 9): isMandatory берётся из каталога живым lookup'ом,
  // а не снимком на момент добавления — правило "обязательное нельзя
  // удалить" следует за актуальным состоянием справочника.
  id           String    @id @default(cuid())
  orderId      String
  stageCode    String
  sequence     Int
  status       String    @default("not_started") // not_started | in_progress | done | problem
  // Исполнитель этапа (Дорожка Г, роадмап 3/9): подрядчик назначается
  // на ЭТАП, а не на заявку целиком — принципиальное отличие от брокера
  // (5а: тот подключается к сделке с этапа расчёта и видит её целиком,
  // брокерские связи — Дорожка Д). null = ещё не назначен или снят;
  // plannedDate/actualDate существуют с Б1, с Г активируются: план
  // ставит менеджер при назначении (Г3), факт проставляет сервер
  // при done (Г4).
  contractorId String?
  plannedDate  DateTime?
  actualDate   DateTime?
  createdAt    DateTime  @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // SetNull явно: прямое удаление подрядчика в БД не тянет за собой
  // этапы — назначения обнуляются, история этапов жива (API-удаления
  // подрядчика нет вовсе, Г3 — это страховка от ручных операций в БД).
  contractor Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([stageCode])
  @@index([contractorId])
}

model StageDocumentRequirement {
  // DF-14: чек-лист документов этапа — какие виды документов нужны для
  // этапа каталога, кто должен предоставить и блокирует ли завершение.
  // Ссылка на каталог — по code (тот же паттерн живого lookup'а, что у
  // OrderStageInstance): имя этапа и его существование читаются из
  // каталога на момент запроса, FK не нужен.
  id         String   @id @default(cuid())
  // Код этапа из OrderStageCatalog.code (валидация — на уровне API).
  stageCode  String
  // Вид документа — код из DOCUMENT_KINDS (lib/document-constants.ts).
  kind       String
  // Кто предоставляет: client | broker | staff (документы перевозчика
  // вносит менеджер — D31: подрядчик в системе не работает).
  providedBy String   @default("client")
  // O-5: дефолты чек-листа включаются «рекомендуется» (false), пока
  // владелец не подтвердит блокировки. true — этап нельзя перевести в
  // done без финального документа этого вида (обход — мастер, P1-05).
  isBlocking Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Одна строка на пару этап+вид: чек-лист — множество, не счётчик
  // (несколько документов вида допустимы, требование — одно).
  @@unique([stageCode, kind])
  @@index([stageCode])
}

// ─── Воронка (Дорожка В, В1) ────────────────────────────────────────
// Lead/QuoteOption добавлены с Дорожкой В; Order получил опциональную
// ссылку leadId (ручные заявки без лида — законны, null).

// P1-03: тип перевозки — справочник колонок (не Json): по нему
// фильтруются списки («Китай → Москва, Море») и заполняется печатная
// форма (бланк п.3). Коды английские (стабильные в API/фильтрах),
// русские подписи — в lib/route-fields.ts (TRANSPORT_TYPE_LABELS).
enum TransportType {
  auto
  rail
  sea
  air
  multimodal
}

// P1-04 (деньги, RULES 2.15): все денежные поля — Decimal + код валюты;
// float и «рубли по умолчанию» запрещены. Коды английские (стабильные
// в API), русские подписи и знаки — в lib/money.ts (formatMoney —
// единственная точка форматирования денег).
// enum Currency (RUB/USD/EUR/CNY) удалён в DF-17: валюты выбираются
// из справочника RefItem(dir=currency) по ISO 4217, фиксированная
// четвёрка больше не отвечает составу сделок. Колонки QuoteOption
// currency/costCurrency переведены в TEXT (см. миграцию df_17_references);
// запасная четвёрка на случай пустой таблицы — money.ts (CURRENCIES).

// Режим НДС цены варианта (P1-04): метка цены, НЕ расчёт — маржа/НДС
// не вычисляются и не отдаются наружу (D19, RULES 2.15). Подписи —
// lib/money.ts (VAT_MODE_LABELS).
enum VatMode {
  WITH_VAT
  WITHOUT_VAT
  ZERO_VAT
}

model Lead {
  id           String   @id @default(cuid())
  // Клиент опционален: лид рождается на этапе запроса, когда клиента
  // в справочнике может ещё не быть (обращение с сайта/по телефону).
  // rawContact хранит анкету как есть; Customer рождается из неё при
  // конвертации (В4), тогда проставляется customerId.
  customerId   String?
  // Черновая анкета { name, phone?, email? } — Json, а не поля: до
  // конвертации структура «сырая» (телефон может быть иностранным,
  // нормализация — только при рождении Customer, см. lib/phone.ts).
  rawContact   Json?
  // Груз/вес/объём/маршрут — свободный Json на этапе запроса.
  cargoInfo    Json?
  // Ручной верхнеуровневый статус воронки (роадмап 8.1 — статусами
  // управляет человек, не этапы): new | calculated | won | lost.
  // «won» вручную поставить нельзя (API В2: 409) — только конвертацией
  // в заявку (В4). Первый добавленный вариант расчёта (В3) переводит
  // new → calculated автоматически.
  status       String   @default("new")
  lostReason   String?
  // И1: откуда родился лид — 'manual' (менеджер, В2) | 'cabinet'
  // (запрос из клиентского кабинета). С default, чтобы db:push на
  // непустой таблице прошёл без разрушения: все существующие лиды
  // созданы руками менеджеров — честное значение по умолчанию.
  source       String   @default("manual")
  createdAt    DateTime @default(now())
  // Ж5 «Требует внимания»: дата последнего изменения — маркер «лид без
  // движения» (порог 3 дня). @default(now()) обязателен: db:push на
  // непустой таблице должен заполнить колонку у существующих строк
  // (счётчик простоя у них пойдёт от момента миграции — честно). Каждый
  // update лида трогает колонку автоматически (@updatedAt); добавление
  // /правка/удаление варианта дополнительно трогает лид явно (В3),
  // чтобы «движением» считалась и работа с вариантами без смены
  // статуса.
  updatedAt    DateTime @default(now()) @updatedAt
  // P1-01: ответственный менеджер лида. При создании (В2) — текущий
  // сотрудник; запрос из кабинета (И1) рождается без ответственного.
  // null = не назначен / снят. SetNull — как у подрядчика на этапе:
  // API-удаления сотрудника нет, страховка от ручных операций в БД;
  // история назначений живёт в Activity-снимках.
  assignedToId String?

  // ─── DF-05 «У кого мяч»: вычисляемое ожидание — см. Order (правила
  // фазы расчёта свои: proforma/брокер/варианты, карточка DF-05).
  waitingOnKind String?
  waitingOnId   String?
  waitingReason String?
  waitingSince  DateTime?

  // ─── P1-03: маршрут и груз — поля, а не только JSON ─────────────
  // Структурированные поля бланка: фильтры списков, сортировки и
  // печатная форма (п.3/17/18/20) читают колонки; cargoInfo хранит
  // «остальное» (v: 1). Миграция переносит из Json: from/to (первая
  // запятая = граница «страна, город»), transportType (словарь
  // Авиа→air…), shipDate → readyDate, вес/объём/места — и удаляет эти
  // ключи из Json. Decimal — точность весов/объёмов (P1-04 принесёт
  // Decimal и деньгам — D19/RULES 2.15).
  originCity         String?
  originCountry      String?
  destinationCity    String?
  destinationCountry String?
  transportType      TransportType?
  readyDate          DateTime?
  weightKg           Decimal?       @db.Decimal(12, 3)
  volumeM3           Decimal?       @db.Decimal(10, 3)
  placesCount        Int?

  // ─── DF-17: поля-коды из справочников (рядом со строками, expand) —
  // см. Order: код из Combobox (IC-16), строка — денормализованное имя
  // (снимок), incotermCode — выбор условия поставки в запросе клиента.
  originCountryCode      String?
  destinationCountryCode String?
  incotermCode           String?
  // DF-19: место условия поставки (свободный текст рядом с кодом —
  // справочника мест DF-17B ещё нет; стартовое значение формы расчёта)
  incotermPlace          String?
  // DF-27: «Пожелания к перевозке» — свободный текст запроса.
  // Колонка добавлена волной 1 (additive), заполняется клиентом и
  // менеджером с волны 2 (окно правки клиента — Р-1, решение владельца).
  wishes                 String?

  customer            Customer?            @relation(fields: [customerId], references: [id])
  assignee            Employee?            @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  options             QuoteOption[]
  order               Order?
  activities          Activity[]
  // Д (роадмап 5а): брокеры консультируют сделку уже на расчёте —
  // связь на уровне лида, до рождения заявки. При конвертации В4
  // переносится в OrderBroker автоматически («переживает конвертацию,
  // не заводится заново» — формулировка роадмапа).
  brokers             LeadBroker[]
  // Е (роадмап 5): документы могут родиться ещё на лида — например,
  // предварительный инвойс для расчёта пошлины брокером; при
  // конвертации В4 переносятся на заявку (leadId → orderId).
  documents           Document[]
  // DF-16: обязательства предоставить разрешительные документы
  // (при конвертации В4 переносятся на заявку, как документы).
  permitRequirements  PermitRequirement[]
  // DF-26 волна 2: проверки ТН ВЭД на лидах (при конвертации В4
  // переносятся на заявку — carryPermitChecksToOrder, SPEC §10.3 п. 6).
  permitChecks        PermitCheck[]
  // DF-19: расчёты таможенных платежей (история версий). DF-27 волна 2
  // (Р-5, §13): при конвертации ИСТОРИЯ нормативных версий переносится
  // на заявку целиком (origin='carried_from_lead'), ничего не
  // перезаписывается; менеджер/брокер — полная история, клиент — только
  // актуальный результат
  customsCalculations CustomsCalculation[]
  // Поток A волна 1 (BL): история согласований расчёта клиентом.
  // Активный снимок = чьи confirmedAt-метаданные совпадают с полями
  // лида ниже; остальные — история (сброшенные/предшествующие),
  // не удаляются и не правятся никогда. Себестоимость в снимок
  // не входит по определению — см. модель.
  approvalSnapshots   LeadApprovalSnapshot[]
  // DF-27 волна 2 (Р-3): неизменяемые печатные редакции заявки (append-only)
  printRevisions      LeadPrintRevision[]

  // ─── Поток A волна 1 (BL-3): активное согласование расчёта ──────
  // Заполняет ТОЛЬКО confirm-API (select-option / confirm), не ручной
  // PATCH: статус client_approved — как won, ставится выделенным
  // действием. selectedOptionId — дубль-гард к isSelected на варианте.
  selectedOptionId     String?
  clientConfirmedAt    DateTime?
  // client_portal (клиент в кабинете) | manager_on_behalf (менеджер)
  clientConfirmedVia   String?
  // id подтвердившего (CustomerUser или Employee) — без FK:
  // деактивация пользователя не должна «стирать» исторический факт
  // (паттерн finalizedByName из DF-12)
  clientConfirmedById   String?
  clientConfirmedByName String?

  @@index([status])
  @@index([customerId])
  @@index([updatedAt])
  @@index([assignedToId])
  @@index([transportType])
  @@index([originCountry])
  @@index([destinationCountry])
  @@index([waitingOnKind, waitingSince])
}

model QuoteOption {
  // Вариант расчёта лида (В3 — API вариантов): один расчёт = один
  // способ доставки (описание + виды транспорта + цена + сроки + чем
  // хорош). Менеджер выбирает ровно один вариант на лид (isSelected,
  // выбор нового снимает прежний — инвариант на уровне API В3).
  id             String   @id @default(cuid())
  leadId         String
  description    String
  transportModes Json?
  // P1-04 (D19, RULES 2.15): цена клиенту (с нашей наценкой) и
  // себестоимость — РАЗДЕЛЬНЫЕ данные. Цена уходит в снимок заявки
  // и клиентские проекции; costEstimate — только сотрудникам
  // (наружу не выходит никогда, D3); маржа не вычисляется.
  price          Decimal  @db.Decimal(14, 2)
  // DF-17: TEXT вместо enum Currency — валюты из справочника ISO 4217
  // (мастер включает/отключает), запасная четвёрка — money.ts
  currency       String   @default("RUB")
  vatMode        VatMode  @default(WITHOUT_VAT)
  // Себестоимость (внутренняя, nullable — «ещё не посчитана»)
  costEstimate   Decimal? @db.Decimal(14, 2)
  costCurrency   String   @default("RUB")
  etaDays        Int
  // Чем вариант лучше других: speed | cost | safety.
  priorityFit    String
  isSelected     Boolean  @default(false)
  createdAt      DateTime @default(now())

  // ─── DF-27 волна 1: вариант — самостоятельный расчёт ─────────────
  // Снимки бланка запроса на момент создания (buildOptionSnapshots,
  // lib/option-snapshots.ts): маршрут и грузовой бланк ЦЕЛИКОМ (включая
  // произвольные ключи cargoInfo) + пожелания. null = легаси-вариант
  // («данные — как в запросе»; заполнение постфактум — fill-from-lead).
  routeSnapshot    Json?
  cargoSnapshot    Json?
  // Промежуточные точки маршрута варианта (ТЗ §4)
  routeStops       Json?
  // Provenance (ТЗ §4): sourceFields — ключи, скопированные из запроса;
  // editedFields — переопределённые менеджером
  sourceFields     Json?
  editedFields     Json?
  // ТЗ §5: предварительный расчёт при незакрытых критичных параметрах
  // + фактический перечень недостающего на момент сохранения
  isPreliminary    Boolean  @default(false)
  missingData      Json?
  // ТЗ §5.5: «данные запроса изменились — пересмотрите цену» (ставит
  // сервер при ценозначимой правке запроса; снимает правка варианта)
  priceReviewRequired Boolean @default(false)
  // Кто последним правил (имя — снимком в ревизии/событии)
  updatedAt        DateTime @default(now()) @updatedAt
  updatedById      String?
  updatedByName    String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  calcLines QuoteOptionCalcLine[]
  revisions QuoteOptionRevision[]
  // DF-27 волна 2 (Р-5): таможенные расчёты, которые велись в контуре варианта
  customsCalculations CustomsCalculation[]

  @@index([leadId])
}

// ─── DF-27 волна 1: строка транспортного расчёта варианта (ТЗ §5) ──
// Статьи стоимости из реестра OPTION_CALC_ARTICLES (lib/option-calc.ts):
// freight/terminal/handling/customs/broker/insurance/lastMile/other.
// fxRateToOffer — снимок курса к валюте предложения на момент
// сохранения; amountOffer (в валюте предложения) считает сервер.
// Строка customs может ссылаться на версию таможенного расчёта —
// это снимок значений, автообновлений нет (D73: пересчёт курса
// связанной версии строку варианта не меняет).
model QuoteOptionCalcLine {
  id                   String   @id @default(cuid())
  optionId             String
  sortOrder            Int
  article              String
  title                String?
  amount               Decimal  @db.Decimal(14, 2)
  currency             String
  fxRateToOffer        Decimal? @db.Decimal(14, 6)
  amountOffer          Decimal? @db.Decimal(14, 2)
  source               String   @default("manual")
  customsCalculationId String?
  comment              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  option QuoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  customsCalculation CustomsCalculation? @relation(fields: [customsCalculationId], references: [id], onDelete: SetNull)

  @@index([optionId, sortOrder])
}

// ─── DF-27 волна 1: история изменений варианта (ТЗ §4) ─────────────
// Структурная история «кем/когда/что изменено» по каждому варианту
// (диффы Activity — текст в description: порядок правок и поле-за-поле
// по ним не восстановить). kind: created | updated | filled_from_lead |
// price_review_reset. Не редактируются и не удаляются; удаление —
// только каскадом с вариантом/запросом (существующая схема).
model QuoteOptionRevision {
  id            String   @id @default(cuid())
  optionId      String
  seq           Int
  kind          String
  actorType     String
  actorId       String?
  actorName     String
  changedFields Json?
  createdAt     DateTime @default(now())

  option QuoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, seq])
  @@index([optionId, createdAt])
}

// ─── Поток A волна 1 (BL): исторический снимок согласования ───────
// Создаётся в той же транзакции, что подтверждение (select-option /
// confirm): копия ВСЕХ коммерческих полей варианта на момент блокировки
// строки лида. Уровень 2 защиты условий (план ред. 3 §2.5): правки или
// удаление исходного QuoteOption (после сброса согласования, после
// отказа) НЕ меняют зафиксированные условия — повторное согласование
// создаёт НОВЫЙ снимок, старые остаются историей навсегда.
// Себестоимость в снимок НЕ входит: она существует исключительно во
// внутренней части заявки (quoteSnapshot на конвертации) — снимок
// согласования по определению клиентская сторона сделки.
// Ссылка на вариант БЕЗ FK (паттерн actorId): удаление варианта не
// каскадит и не портит историю согласования.
model LeadApprovalSnapshot {
  id              String   @id @default(cuid())
  leadId          String
  optionId        String
  optionCreatedAt DateTime
  // Копия коммерческих полей QuoteOption на момент подтверждения
  description     String
  transportModes  Json?
  price           Decimal  @db.Decimal(14, 2)
  currency        String
  vatMode         VatMode  @default(WITHOUT_VAT)
  etaDays         Int
  priorityFit     String
  // Метаданные подтверждения (дубль к полям лида — на каждый факт)
  confirmedAt     DateTime
  confirmedVia    String
  confirmedById   String?
  confirmedByName String?
  // ─── DF-27 волна 2 (Р-3, снимок согласования v2) ──────────────
  // Маршрут/груз — копия снимков варианта на момент подтверждения
  // (иммутабельно, копируются значениями); у легаси-вариантов null.
  routeSnapshot   Json?
  cargoSnapshot   Json?
  // Расчёт на момент согласования: строки и итоги (sumOptionCalc) +
  // isPreliminary/missingData варианта — { v:1, lines, totals,
  // isPreliminary, missingData }; предварительное согласование (Р-3)
  // НЕ превращает цену в окончательное обязательство.
  calcSnapshot    Json?
  // Какая версия таможенного расчёта была при согласовании
  customsCalculationId String?
  // Неизменяемая печатная редакция заявки, которую подтверждают стороны
  printRevisionId String?
  createdAt       DateTime @default(now())

  lead                Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customsCalculation  CustomsCalculation? @relation(fields: [customsCalculationId], references: [id], onDelete: SetNull)
  printRevision       LeadPrintRevision?  @relation(fields: [printRevisionId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

// ─── Подрядчики (Дорожка Г) ────────────────────────────────────────
// Подрядчическая воронка (роадмап 2): ContractorLead (кандидат,
// квалификация) → Contractor (пул). Contractor — глобальный
// справочник, НЕ разовая привязка и НЕ роль Employee (роадмап 1:
// урезанный ЛК — отдельный кабинет с собственной сессией, задел А5).

model Contractor {
  // Справочник пула (роадмап 2): квалифицировали один раз —
  // используется во всех заявках, пока не исключён из пула.
  id               String    @id @default(cuid())
  companyName      String
  // Логин урезанного ЛК (Г4) — тот же паттерн, что у Employee (А5).
  phone            String    @unique
  // hashPassword() из src/lib/password.ts — стартовый пароль задаёт
  // менеджер при переводе кандидата в пул (Г2), смена — PATCH (Г3).
  password         String
  // Виды транспорта/направления — Json, структуру не фиксируем до
  // реальных форм (роадмап 9); допуски (негабарит/опасные, фильтр по
  // CargoProfile) — Phase 2, добавятся внутрь Json без миграции
  // (роадмап 6 — «точка расширения на старте»).
  competencies     Json?
  // Контактное лицо/email/реквизиты — сырой Json по образцу rawContact
  // лида (В1): до реальных форм структуру сознательно не фиксируем.
  contactInfo      Json?
  // Факт договора с подрядчиком — только номер + дата (тарифы из
  // Приложений, УПД и взаиморасчёты — финансовая модель, осознанно
  // вне MVP, роадмап 9). Прообраз из разбора S13: ИП Сванишвили,
  // договор 0105/1-СВ.
  contractNumber   String?
  contractSignedAt DateTime?
  // Пул: false = не назначается на новые этапы (Г3 отклонит), но
  // существующие назначения и вход в ЛК живут — мягкое исключение
  // (иначе сорванные перевозки). API-удаления подрядчика нет вовсе
  // (Г3): история заявок не должна терять исполнителей.
  isActive         Boolean   @default(true)
  comment          String?
  createdAt        DateTime  @default(now())

  sessions   ContractorSession[]
  lead       ContractorLead?
  stages     OrderStageInstance[]
  activities Activity[]

  @@index([isActive])
}

model ContractorSession {
  // Сессия урезанного ЛК подрядчика — по образцу EmployeeSession
  // (А5: своя сессия на каждый тип внешнего пользователя, не роль
  // в общей таблице пользователей).
  id           String   @id @default(cuid())
  contractorId String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([token])
}

model ContractorLead {
  // Кандидат в пул (роадмап 2): свой чек-лист квалификации — НЕ копия
  // клиентской воронки один в один, статусы свои.
  id           String   @id @default(cuid())
  companyName  String
  // Черновая анкета кандидата (контакты/что возит/зоны/источник) —
  // толерантный Json по образцу rawContact лида (В1): API структуру
  // не валидирует, известные ключи UI показывает по меткам (Г5).
  rawInfo      Json?
  // Ручные статусы (симметрия 8.1 — решает человек, не триггер):
  // new | qualifying | contracted | rejected. «contracted» руками
  // не ставится — только рождением Contractor в транзакции (Г2),
  // как «won» у лида (В2/В4); терминален, повторный 409.
  status       String   @default("new")
  // Причина отказа — обязательна при rejected (симметрия lostReason).
  rejectReason String?
  // Рождённый подрядчик: 1:1 (@unique), связь проставляется в
  // транзакции перевода contracted (Г2) и не рвётся.
  contractorId String?  @unique
  createdAt    DateTime @default(now())
  // Ж5: маркер «без движения» по образцу Lead.updatedAt — экран
  // внимания сейчас смотрит только клиентские лиды, колонка ставится
  // сразу, чтобы вторая воронка не требовала новой миграции, когда
  // до неё дойдёт очередь (зеркальный комментарий Lead).
  updatedAt    DateTime @default(now()) @updatedAt

  contractor Contractor? @relation(fields: [contractorId], references: [id])

  @@index([status])
  @@index([updatedAt])
}

// ─── И1: сессия клиентского кабинета ───────────────────────────
// По образцу EmployeeSession (А5) и ContractorSession (Г4): своя
// сессия на каждый тип внешнего пользователя, не роль в общей
// таблице (роадмап, раздел 1 — «три портала, не три роли»).
model ClientSession {
  id         String   @id @default(cuid())
  customerId String
  // DF-02A: сессия конкретного человека (D34). Nullable — переходный
  // период: сессии, созданные миграцией df_02a_company_users, userId
  // получают сразу (привязаны к основному пользователю компании);
  // null остаётся возможен только в окне деплоя (код ещё не пишет
  // пользователя) и трактуется как сессия компании.
  userId     String?
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     CustomerUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([token])
  @@index([userId])
}

// ─── DF-02A: пользователь клиентской компании (D34, пересмотр P1-07) ──
// У компании несколько личных входов; пользователь кабинета — контакт
// с признаком «есть вход» (P1-07): параллельную модель контактов НЕ
// создаём, name/phone/email живут здесь. password = null — контакт
// без входа (доступ выдаёт менеджер). Пароль — hashPassword() из
// src/lib/password.ts; при выдаче/смене пароля хеш переносится в
// CustomerUser (lib/company-users.ts), старое поле Customer.password
// остаётся до contract-релиза (docs/DEPRECATIONS.md).
// phone — @unique ГЛОБАЛЬНО (поток A волна 2, AUD-03 — решение
// владельца А2, план ред. 3 §5.1): вход ищет пользователя по телефону —
// дубль делал findFirst недетерминированным; cross-409 в
// lib/company-users.ts дополнен физическим уникальным индексом
// CustomerUser_phone_key (миграция bl_phone_ops) + backstop P2002.
// Postgres допускает любое число NULL в уникальном индексе — контакт
// без входа (phone null) не ограничен.
model CustomerUser {
  id          String    @id @default(cuid())
  customerId  String
  name        String
  phone       String?   @unique
  email       String?
  password    String?
  // Основной пользователь компании — перенос старого входа компании
  // (миграция df_02a_company_users). Один на компанию (защита в
  // lib/company-users.ts); деактивации не подлежит — доступ компании
  // целиком закрывается деактивацией компании (Customer.isActive).
  isPrimary   Boolean   @default(false)
  // Деактивация = доступ закрыт для ЭТОГО человека (паттерн компании
  // И1): живые сессии пользователя гаснут немедленно
  // (lib/company-users.ts), вход деактивированного — 403 после сверки
  // пароля.
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  // BL-8 (план ред. 3 §2.6, миграция bl_phone_ops): заявка на смену
  // телефона, ожидающая подтверждения кодом. Подтверждённый телефон
  // остаётся в phone — вход работает до и после смены без перерыва;
  // поля одни на пользователя: повторный запрос кода перезаписывает
  // старый. phoneCodeHash — ДЕТЕРМИНИРОВАННЫЙ sha256 кода (как коды
  // восстановления DF-09): солевой scrypt несовместим с WHERE
  // атомарного одноразового захвата (updateMany по hash+TTL+лимиту).
  pendingPhone       String?
  phoneCodeHash      String?
  phoneCodeExpiresAt DateTime?
  phoneCodeAttempts  Int       @default(0)

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions ClientSession[]

  @@index([customerId])
}

// ─── Дорожка Д: брокеры (роадмап 5а) ────────────────────────────────
// Брокер подключается к сделке ЦЕЛИКОМ — на уровне лида (с этапа
// расчёта) и заявки (после конвертации), а не к отдельному этапу:
// стоимость оформления декларации входит в сумму варианта расчёта,
// то есть брокер нужен ДО появления заявки. Видимость — «заявка
// целиком», не per-stage (принципиальное отличие от подрядчика, Г).
// Все таблицы новые — db:push на живой базе не разрушающий.

model Broker {
  // Справочник привлечённых таможенных представителей (роадмап 1/6:
  // штатный/привлечённый — атрибут isInHouse, не отдельная модель;
  // «экран назначить штатного» на старте не реализуем).
  id          String   @id @default(cuid())
  companyName String
  // Бывший логин урезанного ЛК (Д) — сегодня phone остаётся СПРАВОЧНЫМ
  // телефоном компании; вход — у человека (BrokerUser.phone @unique,
  // DF-02A). Уникальность оставлена: номер компании не должен дублироваться.
  phone       String   @unique
  // DF-02: контактный email компании брокера для уведомлений
  // (адресат-человек живёт в BrokerUser.email, DF-03; это поле —
  // общий адрес компании, фолбэк recipientsOfBroker).
  email       String?
  // Пароль компании (Broker.password) удалён contract-миграцией
  // df_03_contract: вход через authenticateBrokerLogin (BrokerUser),
  // пароль человека задаётся в справочнике пользователей брокера.
  // Штатный/привлечённый — только пометка для справочника, на права
  // не влияет (роадмап 6: «деталь атрибута, не отдельная модель»).
  isInHouse   Boolean  @default(false)
  // Деактивация = доступ закрыт (паттерн клиента И1, не подрядчика):
  // брокер — внешний участник сделки, перестали работать — видеть
  // сделки он больше не должен. Проверка живая в broker-auth (сессия
  // гаснет немедленно), вход деактивированного — 403 после сверки
  // пароля; новые подключения — 409.
  isActive    Boolean  @default(true)
  comment     String?
  // Контактное лицо/email — сырой Json по образцу contactInfo
  // подрядчика (Г1): структуру не фиксируем до реальных форм.
  contactInfo Json?
  createdAt   DateTime @default(now())

  sessions   BrokerSession[]
  users      BrokerUser[]
  leadLinks  LeadBroker[]
  orderLinks OrderBroker[]
}

model BrokerSession {
  // Сессия урезанного ЛК брокера — по образцу EmployeeSession (А5),
  // ContractorSession (Г4) и ClientSession (И1): четвёртый портал,
  // своя кука, не роль в общей таблице (роадмап, раздел 1).
  id        String   @id @default(cuid())
  brokerId  String
  // DF-02A: сессия конкретного человека (D34) — семантика как у
  // ClientSession.userId (null только в окне деплоя).
  userId    String?
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  broker Broker      @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  user   BrokerUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([token])
  @@index([userId])
}

// ─── DF-02A: пользователь брокерской компании (D34) ──────────────────
// Зеркало CustomerUser для брокера (Г1-переиспользование решения:
// одна семантика, две таблицы — справочники разделены, FK на разные
// корни). Отличие: phone @unique — наследование уникальности
// Broker.phone (вход брокера и сегодня детерминирован findUnique).
// password = null — контакт без входа; isPrimary — перенос старого
// входа компании (миграция df_02a_company_users), деактивации не
// подлежит (доступ закрывается на уровне Broker.isActive).
model BrokerUser {
  id          String    @id @default(cuid())
  brokerId    String
  name        String
  phone       String?   @unique
  email       String?
  password    String?
  isPrimary   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  broker   Broker          @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  sessions BrokerSession[]

  @@index([brokerId])
}

model LeadBroker {
  // Связь «брокер консультирует расчёт» (роадмап 5а, черновик 9).
  // ОДНА связь работает и на расчёте, и после конвертации: оценка
  // таможенных платежей (BrokerEstimate, 1:1) живёт здесь и переживает
  // конвертацию — заявка до неё доходит через order.lead (лиды с
  // заявкой не удаляются, В2), так что оценка не теряется и после
  // перехода сделки в исполнение.
  id        String   @id @default(cuid())
  leadId    String
  brokerId  String
  createdAt DateTime @default(now())

  lead     Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  broker   Broker          @relation(fields: [brokerId], references: [id])
  estimate BrokerEstimate?

  // Повторное подключение того же брокера к тому же лиду — ошибка
  // данных, уникальность ловит гонку двойного клика.
  @@unique([leadId, brokerId])
  @@index([brokerId])
}

model OrderBroker {
  // Видимость заявки целиком для брокера (5а) — не per-stage.
  // Рождается конвертацией из LeadBroker (В4) либо прямым подключением
  // менеджером (заявки без лида, подключение после конвертации).
  id        String   @id @default(cuid())
  orderId   String
  brokerId  String
  createdAt DateTime @default(now())

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  broker Broker @relation(fields: [brokerId], references: [id])

  @@unique([orderId, brokerId])
  @@index([brokerId])
}

model BrokerEstimate {
  // То, что брокер обязан сообщить ещё на этапе расчёта (роадмап 5а):
  // (а) ожидаемый размер таможенных платежей и (б) список
  // разрешительных документов. Прямой вход в цену варианта расчёта
  // (QuoteOption.priceEstimate) — но ценообразование отложено
  // (решение И1), поэтому оценка пока внутренняя: менеджер видит её
  // на карточках лида/заявки, клиенту не показывается. Обновлять
  // может только сам брокер (его заявление, не слово менеджера).
  id                  String    @id @default(cuid())
  leadBrokerId        String    @unique
  // P1-04: Decimal по RULES 2.15 (все деньги — Decimal). Валюта —
  // RUB по природе платежа (таможенные платежи РФ, ТК ЕАЭС) —
  // отдельный код валюты не нужен. Nullable — «посчитаю позже»:
  // брокер может сначала сообщить список документов, а сумму потом.
  customsDutyEstimate Decimal?  @db.Decimal(14, 2)
  // Список разрешительных документов (строки: «Сертификат
  // соответствия», «Лицензия Минпромторга»…). Json, а не связь со
  // справочником: разрешительная база по ТН ВЭД — Phase 2 (роадмап 6),
  // сейчас это свободный список.
  requiredPermits     Json?
  notes               String?
  // DF-18: статус ответа брокера. draft — черновик (меняется свободно,
  // событие broker_estimate_changed как раньше); sent — отправлен
  // менеджеру (событие broker_estimate_sent, ответственный получает
  // уведомление). Правки после отправки пишутся estimate_updated с
  // разницей строк; sentAt — момент ПЕРВОЙ отправки, не перезаписывается.
  status              String    @default("draft")
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  // @updatedAt: оценка уточняется (точные платежи после классификации
  // товара) — менеджеру важно видеть, насколько свежие цифры.
  updatedAt           DateTime  @default(now()) @updatedAt

  // Строки по кодам ТН ВЭД (DF-18): «код · пошлина % · доп. пошлина % · НДС %».
  items BrokerEstimateItem[]

  leadBroker LeadBroker @relation(fields: [leadBrokerId], references: [id], onDelete: Cascade)
}

// DF-18: строка ответа брокера по одному коду ТН ВЭД (D38). Брокер
// считает в Альте — система хранит ТОЛЬКО проценты и пометки, никакой
// арифметики ДТ. Проценты — Decimal (RULES 2.15), null = «не указано»;
// addDutyPercent null означает «доп. пошлины нет». rateNote — нестандартная
// ставка («2 €/кг»): строка с ней считается вручную (isManualRate,
// lib/brokers.ts) — в DF-19 такая строка не вычисляется автоматически.
model BrokerEstimateItem {
  id             String   @id @default(cuid())
  estimateId     String
  // Порядок строки — как внесли в форме (отображение и diff сохраняют порядок).
  sortOrder      Int
  // 10 цифр ТН ВЭД — из справочника DF-17C или вручную. isManualCode
  // верифицирует СЕРВЕР по справочнику на момент сохранения (пометку
  // клиента не верим); «вручную» = код не найден среди действующих.
  hsCode         String
  isManualCode   Boolean  @default(false)
  dutyPercent    Decimal? @db.Decimal(5, 2)
  addDutyPercent Decimal? @db.Decimal(5, 2)
  // «антидемпинговая», «компенсационная»… — к какому виду относится доп. пошлина
  addDutyNote    String?
  vatPercent     Decimal? @db.Decimal(5, 2)
  // Нестандартная ставка («2 €/кг», «от 0,1 до 2,1 €/кг») — вместо процентов
  rateNote       String?
  createdAt      DateTime @default(now())

  estimate BrokerEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, sortOrder])
}

// ─── Дорожка Е: документооборот внутри сервиса (роадмап 5) ────────
// Обмен документами (товаросопроводительные, правки от брокера)
// внутри платформы, не через внешнюю почту. Участвуют три стороны:
// клиент, брокер и менеджер (подрядчик в контуре Е отсутствует —
// роадмап 5 его не называет). Видимость: любой брокер, связанный с
// заявкой через OrderBroker (или с лидом через LeadBroker, пока
// заявки нет), видит все НЕ внутренние документы этой сделки —
// видимость определяется связью со сделкой, не привязкой к этапу
// (5а, поле stageInstanceId из черновика сознательно убрано).
//
// Все таблицы новые — db:push на живой базе не разрушающий.

model Document {
  id              String    @id @default(cuid())
  // Цель — ровно одна: лид ИЛИ заявка (инвариант на уровне роутов,
  // как у Activity — SQLite не умеет CHECK между колонками).
  // Документ на лиде живёт своей жизнью до конвертации, затем В4
  // переносит его на заявку (leadId → orderId, связь с лидом через
  // order.lead остаётся у сделки, история не рвётся).
  orderId         String?
  leadId          String?
  // Стабильный код типа из DOCUMENT_TYPES (lib/document-constants.ts):
  // accompanying | invoice | permit | customs | contract | application | other
  type            String
  // DF-12: вид документа по D5 (справочник DOCUMENT_KINDS). null —
  // легаси-строка до backfill миграции df_12_document_lifecycle.
  kind            String?
  // DF-12: жизненный цикл draft | in_review | final (переходы —
  // DOCUMENT_TRANSITIONS в lib/status-machine.ts).
  status          String    @default("draft")
  // DF-12: снимок финализации (кто/когда/какая версия объявлена
  // финальной); при возврате в работу хранится до следующего «Финальный».
  finalizedAt     DateTime?
  finalizedByName String?
  finalVersion    Int?
  // DF-12: код этапа каталога — привязка документа к этапу; точка
  // записи появляется с привязкой в UI (DF-13/DF-14).
  stageCode       String?
  // Человекочитаемое название («Инвойс № INV-123», «Упаковочный лист»).
  title           String
  // Видимость: внутренние документы (подрядческие договоры, тарифы)
  // видны только сотрудникам — клиент и брокер их не видят ни в
  // списках, ни в скачивании. Решение №1 от 14.10.2026 (клиент не
  // видит ставки) + Д (брокер не видит подрядческих условий): без
  // флага менеджеру некуда положить «не для внешних» файл. Симметрия
  // с Activity.isInternal (Ж3). Клиент и брокер создавать внутренние
  // не могут — роуты принуждают false.
  isInternal      Boolean   @default(false)
  // Номер последней версии (кэш для списков без подсчёта версий).
  currentVersion  Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  order    Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lead     Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([orderId])
  @@index([leadId])
}

model DocumentVersion {
  // Версия документа: файл + автор + комментарий «что изменено и
  // почему» (роадмап 5: проект правится несколько раз до финала,
  // минимум — история версий с датой и автором правки).
  id                String   @id @default(cuid())
  documentId        String
  version           Int
  // Метаданные файла: оригинальное имя (санитизированное при загрузке),
  // MIME из белого списка (DOC_ALLOWED_MIME), размер в байтах.
  fileName          String
  mimeType          String
  fileSize          Int
  // Содержимое легаси-версий — в БД (bytea). Новые загрузки (DF-11) байты
  // в БД не пишут: объект лежит в S3-совместимом хранилище по storageKey,
  // скачивание — 302 на presigned GET. Поле остаётся до переноса всех
  // строк скриптом migrate-files-to-storage.ts (DEPRECATIONS.md).
  fileData          Bytes?
  // DF-11: ключ объекта в хранилище (уникален по построению:
  // docs/<id сделки>/<uuid>/<имя>). null — легаси-версия, байты в fileData.
  storageKey        String?
  // DF-11: статус загрузки: pending (метаданные созданы, объект ещё не
  // подтверждён) | ready (объект в хранилище проверен сигнатурой). Легаси-
  // строки — ready по умолчанию; pending без объекта скачиванию не подлежит.
  status            String   @default("ready")
  // Что изменено и почему — правка от брокера/клиента.
  comment           String?
  // Кто загрузил: сотрудник | клиент | брокер (подрядчика в контуре Е
  // нет). authorName — снимок имени на момент загрузки (лента Ж2).
  authorType        String
  authorId          String?
  authorName        String
  // DF-26 волна 2 (SPEC §6.1/§10.2): двойной снимок автора версии —
  // тот же backfill-паттерн, что у Activity.
  authorUserName    String?
  authorCompanyName String?
  createdAt         DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Гонка двух одновременных загрузок версии: обе прочитали
  // currentVersion=1 → обе создают v2 → уникальность ловит одну,
  // роут повторяет с новым номером (паттерн retry Б4).
  @@unique([documentId, version])
  @@index([documentId])
}

// DF-16: обязательство предоставить разрешительный документ (D35).
// Рождается из ответа брокера (free-список requiredPermits превращается
// в строки — sync при PUT оценки и разовая миграция данных) или
// добавляется вручную брокером/сотрудником через /permits. Закрывается
// загрузкой документа прямо в строке (Document.type='permit', reюз
// контура Е) либо «не требуется» с причиной (только сотрудник).
//
// Цель — ровно одна: лид ИЛИ заявка (инвариант как у Document/Activity;
// при конвертации В4 строки переносятся carryPermitsToOrder — лид →
// заявка, связь со сделкой не рвётся). documentId — БЕЗ FK (паттерн
// stageId/documentId у Activity: ссылка живёт дольше цели); удаление
// документа (только сотрудник) возвращает строку в pending (lib/documents.ts).
//
// providedBy — КТО должен предоставить: client | broker | staff. От него
// зависит адресат напоминаний (правило permit_overdue) и держатель мяча
// awaiting_permit (DF-05). staffNote — внутренняя заметка строки, наружу
// не отдаётся (проекция PERMIT_EXTERNAL_FIELDS). source='estimate' —
// строка ведётся свободным списком ответа брокера (sync разрешает
// удалять её при исчезновении из списка); source='manual' — создана
// через /permits и автоматически не удаляется. lastRemindedAt — отметка
// скана просрочки (диспетчер): красное событие не чаще раза в
// permits.remind_every_days суток на строку (идемпотентность повтора).
model PermitRequirement {
  id                     String                   @id @default(cuid())
  orderId                String?
  leadId                 String?
  title                  String
  providedBy             String // client | broker | staff
  // DF-26 волна 2: этап, который требование блокирует (SPEC §9).
  // NULL у существующих строк и требований «без этапа» — блокировка
  // этапа на них не появляется внезапно (гард считает только
  // isBlocking + stageCode IS NOT NULL).
  stageCode              String?
  // Блокирует отправку/этап — красный сигнал и скан просрочки только
  // для блокирующих строк (красный — только срочное, §3.3 брендбука).
  isBlocking             Boolean                  @default(false)
  // Срок предоставления (дата, необязательно) — из него считаются
  // «красное окно» permits.red_days_before и просрочка.
  neededBy               DateTime?
  // DF-26 волна 2: домен расширен значением submitted (SPEC §5.4:
  // загрузка ≠ принятие). pending | submitted | received | waived.
  status                 String                   @default("pending")
  // Загруженный документ (Document.type='permit') без FK; receivedAt/
  // receivedByName — снимок факта и того, кто загрузил.
  documentId             String?
  receivedAt             DateTime?
  receivedByName         String?
  // DF-26 волна 2 (SPEC §5.4/§10.2): снимок загрузившего (когда
  // строка перешла в submitted) — одиночный и двойной (§6.1).
  submittedAt            DateTime?
  submittedByName        String?
  submittedByUserName    String?
  submittedByCompanyName String?
  // DF-26 волна 2 (SPEC §6.4): фактически принятая версия связанного
  // документа («Принять» — текущая, finalize — объявленная финальной);
  // при авто-возврате в submitted НЕ затирается — «ранее принята
  // версия N». Backfill — только при единственной готовой версии (§10.3).
  acceptedVersion        Int?
  // DF-26 волна 2 (SPEC §10.2): двойные снимки автора и принявшего —
  // backfill только из исторических снимков (createdByName/
  // receivedByName), текущие профили не читаются (§10.3).
  createdByUserName      String?
  createdByCompanyName   String?
  receivedByUserName     String?
  receivedByCompanyName  String?
  // DF-26 волна 2 (SPEC §5.7 п. 0а): состояние привязки к позиции —
  // bound (норма; bound + itemId=NULL — «ко всей сделке») |
  // pending_manual («требует ручной привязки» — строка оценки
  // удалена при дифф-сохранении; itemId хранит замороженную ссылку).
  // CHECK chk_permitreq_binding_state — в миграции df_26_docs_center.
  bindingState           String                   @default("bound")
  // DF-26 волна 2: требования, созданные проверкой (происхождение —
  // PermitCheckRequirement, у строки ровно одно происхождение).
  checks                 PermitCheckRequirement[]
  // «Не требуется» — только сотрудник, с причиной (строка остаётся в
  // истории, плашка исчезает у всех сторон).
  waivedReason           String?
  // Внутренняя заметка строки — только сотрудникам (наружу не отдаётся).
  staffNote              String?
  // Привязка к строке ответа брокера (BrokerEstimateItem.id, БЕЗ FK —
  // строки оценки пересоздаются каждым PUT; remap в роуте оценки
  // восстанавливает связь по коду ТН ВЭД). Null = ко всему запросу.
  itemId                 String?
  // Происхождение строки: estimate (sync ответа брокера) | manual (/permits).
  source                 String                   @default("manual")
  // Кто добавил — снимок (паттерн actorName): сотрудник | клиент |
  // брокер | система (миграция данных).
  createdByType          String
  createdById            String?
  createdByName          String
  lastRemindedAt         DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt

  // Cascade — как у Document: сделка без заявки удаляется мастером,
  // её обязательства бессмысленны без сделки (лента уходит каскадом тоже).
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lead  Lead?  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([leadId, status])
}

// DF-26 волна 2 (SPEC §5.1): проверка разрешительных по коду ТН ВЭД —
// ЗАПИСЬ О РЕЗУЛЬТАТЕ, а не требование (требование — PermitRequirement).
// Одна проверка на пару (сделка, код): результат — свойство пары, все
// позиции кода получают один ответ. Охват позиций — связями
// PermitCheckItem (скаляра позиции у проверки нет; позицию
// needs_review-записи несёт reviewItemId). Инварианты закреплены
// ограничениями БД (CHECK «ровно одна цель», частичные уникальные
// индексы открытых записей — миграция df_26_docs_center).
model PermitCheck {
  id                    String    @id @default(cuid())
  // Цель — ровно одна: заявка ИЛИ лид (CHECK chk_permitcheck_one_target
  // физически; API дополнительно проверяет до INSERT — 400).
  orderId               String?
  leadId                String?
  // Код ТН ВЭД (10 знаков), по которому проверяли.
  hsCode                String
  // Позиция needs_review-записи (§5.7): только для пересмотра; у
  // первичных и ручных проверок NULL. При удалении строки оценки
  // ссылка сохраняется замороженной (§5.7 п. 0а).
  reviewItemId          String?
  // required | not_required | unclear | failed (auto — всегда unclear,
  // система не создаёт требования сама — инвариант 2).
  result                String
  // Основание/источник (ТР ТС 018/2011, решение брокера, письмо…).
  basis                 String?
  dictionaryVersion     String? // версия справочника; ручная — 'manual:<дата>'
  // auto | manual. Автоматический источник — точка расширения (О7).
  source                String    @default("manual")
  // Кто проверил — одиночный снимок + двойной (§6.1).
  checkedByType         String
  checkedById           String?
  checkedByName         String
  checkedByUserName     String?
  checkedByCompanyName  String?
  // Пересмотр при изменении кода (§5.7): ссылка на предыдущую проверку
  // той же позиции; статус none | needs_review | reviewed.
  reviewOfCheckId       String?
  reviewStatus          String    @default("none")
  reviewedAt            DateTime?
  reviewedByUserName    String?
  reviewedByCompanyName String?
  // requirement_kept | requirement_waived | new_requirement |
  // not_required | unclear_confirmed | mixed (§5.7 п. 3/3а).
  reviewOutcome         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  order        Order?                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lead         Lead?                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Пересмотр: проверка-предшественник (история не редактируется,
  // удалять проверки API не умеет — Restrict как страховка).
  reviewOf     PermitCheck?             @relation("PermitCheckReview", fields: [reviewOfCheckId], references: [id], onDelete: Restrict)
  reviews      PermitCheck[]            @relation("PermitCheckReview")
  // Охваченные позиции (инвариант 3) и созданные требования (§5.3).
  items        PermitCheckItem[]
  requirements PermitCheckRequirement[]

  @@index([orderId, result])
  @@index([leadId, result])
  @@index([reviewStatus])
}

// DF-26 волна 2 (SPEC §5.1, замечание 2 ред. 1.4): связь «проверка →
// охваченные позиции» — позиции сделки с текущим hsCode записи. Без FK
// на itemId (строки оценки пересоздаются/удаляются; охват открытой
// auto-записи синхронизируется дифф-сохранением оценки — §5.7 п. 0а;
// у подтверждённой фиксируется на момент решения). UNIQUE пары —
// uq_permitcheckitem_pair в миграции.
model PermitCheckItem {
  id            String   @id @default(cuid())
  permitCheckId String
  // BrokerEstimateItem.id БЕЗ FK (паттерн PermitRequirement.itemId).
  itemId        String
  createdAt     DateTime @default(now())

  permitCheck PermitCheck @relation(fields: [permitCheckId], references: [id], onDelete: Cascade)

  // map — имя из SPEC §5.1/§10.2 (uq_permitcheckitem_pair), не конвенция
  // Prisma: уникальность пары «проверка — позиция» именована миграцией.
  @@unique([permitCheckId, itemId], map: "uq_permitcheckitem_pair")
  @@index([itemId])
}

// DF-26 волна 2 (SPEC §5.1, замечание 2 ред. 1.3): связь «проверка →
// созданные ею требования». У каждого созданного проверкой требования
// ровно одно происхождение (UNIQUE permitRequirementId); требования
// без проверки (source='estimate'/manual) строк связи не имеют.
model PermitCheckRequirement {
  id                  String   @id @default(cuid())
  permitCheckId       String
  permitRequirementId String
  createdAt           DateTime @default(now())

  permitCheck       PermitCheck       @relation(fields: [permitCheckId], references: [id], onDelete: Cascade)
  permitRequirement PermitRequirement @relation(fields: [permitRequirementId], references: [id])

  @@unique([permitRequirementId])
  @@index([permitCheckId])
}

// ─── Журнал событий (Дорожка Ж, Ж2) ────────────────────────────────
// Лента «кто что сделал и когда» для заявки, лида и подрядчика.
// Пишется хелпером emitEvent() (lib/events.ts, единая точка с DF-01)
// из write-роутов — прямой create в роутах не допускается, чтобы
// инвариант «не больше одной цели», аудитория и формат актёра
// держались в одном месте.
model Activity {
  id               String   @id @default(cuid())
  // Цель события — не больше одной из трёх (инвариант union
  // ActivityTarget на TS-уровне; SQLite не умеет CHECK-ограничения
  // между колонками). События сделки несут ровно одну цель — удаление
  // цели каскадное: лента удалённой сущности бессмысленна (лид без
  // заявки можно удалить В2, заявки и подрядчики API-удаления не
  // имеют, но страховка от ручных операций в БД та же, что у этапов
  // Г3). ГЛОБАЛЬНЫЕ события возможны без цели — все три колонки
  // nullable (DF-00D: setting_changed — настройка не belongs сделке;
  // читается только staff-лентой).
  orderId          String?
  leadId           String?
  contractorId     String?
  // Кто действовал: сотрудник | подрядчик | система. actorName —
  // СНИМОК на момент действия: переименование/деактивация сотрудника
  // или подрядчика историю не переписывают, живой lookup ленте не
  // нужен. actorId — строка без FK по той же причине: справочник
  // живёт короче истории (и не тянет каскады при чистках).
  actorType        String // employee | contractor | client | broker | system
  actorId          String?
  actorName        String
  // DF-26 волна 2 (SPEC §6.1): двойной снимок — имя и компания НА
  // МОМЕНТ ДЕЙСТВИЯ. Заполняется emitEvent'ом, когда известны; backfill
  // миграции df_26_docs_center — только из исторического снимка
  // actorName по типу актёра (client/broker → компания; employee/
  // contractor/system → имя), текущие профили не читаются.
  actorUserName    String?
  actorCompanyName String?
  // Стабильный код события (словарь ACTIVITY_TYPES в lib/activity.ts)
  // и человекочитаемое описание с деталями — что именно изменилось.
  type             String
  description      String
  // Ж3: приватность события несёт audience (staff-only = «не показывать
  // внешним кабинетам»): read-контексты фильтруют через eventWhereFor
  // (lib/audience.ts), админская лента видит всё. Колонка isInternal
  // удалена contract-миграцией df_03_contract (DEPRECATIONS 0.6.5):
  // двойная правда «isInternal ⇔ audience=={staff}» заменена одной
  // колонкой audience.
  createdAt        DateTime @default(now())

  // DF-01: аудитория события — кому ВИДНО в лентах кабинетов
  // (staff | client | broker; 'contractor' зарезервирован ради
  // замороженного кабинета и в новых событиях не используется —
  // D31, инвариант §1.3 ROADMAP-DEALFLOW). Видимость считает
  // lib/audience.ts (eventWhereFor), роуты фильтр не копируют.
  // isInternal остаётся согласованно: isInternal = (audience == {staff});
  // удаление колонки — отдельный contract-релиз после DF-03.
  audience   String[] @default([])
  // DF-01: связь события с этапом/документом БЕЗ FK (как actorId —
  // история живёт дольше справочников, удаление цели не рвёт ленту).
  // stageId — для «кто тормозит» в Пульсе (DF-07), documentId — для
  // уведомлений о документах (DF-03) и пакета документов (DF-13).
  stageId    String?
  documentId String?

  order      Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contractor Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([leadId, createdAt])
  @@index([contractorId, createdAt])
}

// ─── З2: защита входа от перебора ──────────────────────────────
// Каждая попытка входа сотрудников и подрядчиков: провал сверки
// учётных данных (401) ИЛИ успех (аудит). Лимиты считает
// lib/login-guard.ts (скользящие окна): 5 провалов/мин и 20/час
// на IP, 10 провалов/5 мин на пару «логин + IP»; по одному логину —
// только замедление, без блокировки (E0-05).
// Новая таблица без ссылок на остальные — db:push не разрушающий.
model LoginAttempt {
  id        String   @id @default(cuid())
  // employee | contractor | client | broker — какой из четырёх входов
  // дёргали (в предыдущем проекте порталов было три, но различие в таблице он не
  // хранил; здесь храним — аудиту важно, какую дверь дёргали; Д
  // добавила четвёртую дверь)
  kind      String
  ip        String   @default("unknown")
  // Логин в нормализованном виде (+7XXXXXXXXXX). Nullable — на
  // случай будущего входа без логина (мастер-пароль в прошлом проекте).
  login     String?
  userAgent String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([login, createdAt])
  @@index([createdAt])
}

// ─── DF-00D: настройки системы (D32, инвариант 9) ──────────────
// Бизнес-параметры (окна рассылок, лимиты, пороги, часовой пояс,
// подписи) живут здесь, а не литералами в коде: владелец меняет их
// на экране /admin/settings без выката. Правило выбора места:
// секрет/адрес инфраструктуры → env; бизнес-параметр → эта таблица;
// перечень, с которым связана логика (виды документов, типы
// событий, статусы) → реестр в коде.
//
// key — стабильный код из реестра SETTINGS (src/lib/settings.ts);
// free-form ключи не допускаются: setSetting пишет только ключи
// реестра, значение проходит валидатор. value — Json: форма зависит
// от типа настройки (строка/число/массив), структуру знает
// реестр, БД не проверяет (валидация — TS-уровень, инвариант
// хелпера). Таблица МОЖЕТ БЫТЬ пустой: getSetting откатывается на
// значение по умолчанию — система работает и без неё (миграция
// expand-безопасна, старый код её не трогает).
//
// updatedByName — СНИМОК имени мастера (как actorName у Activity):
// без FK, справочник сотрудников живёт короче истории настроек,
// переименование не переписывает журнал. Факт изменения дублируется
// событием setting_changed (аудитория staff, старое/новое значение,
// без секретов) — единая точка записи emitEvent.
model Setting {
  key           String   @id
  value         Json
  updatedAt     DateTime @updatedAt
  updatedByName String
}

// ─── DF-03: очередь уведомлений и письма трёх режимов (D33) ──────────
// Единая очередь исходящих уведомлений: событие сделки (Activity) →
// правила матрицы §8 ROADMAP-DEALFLOW (lib/notifications/rules.ts) →
// строки очереди → диспетчер (lib/notifications/dispatch.ts) →
// транспорт (Resend HTTP API / fake / заглушки Telegram-WhatsApp).
// Очередь — ЖУРНАЛ: переживает удаление сделки и события, FK не имеет
// (паттерн actorId/Setting.updatedByName — ссылка живёт дольше цели).
//
// recipientKind: employee | client | broker ('contractor' зарезервирован
// и не используется, D31 — кабинет заморожен, подрядчик писем не
// получает). recipientId — id ЧЕЛОВЕКА-получателя: Employee.id либо
// CustomerUser/BrokerUser.id (адресат-человек, DF-02A); null — письмо
// на общий адрес компании (фолбэк recipientsOfCustomer/recipientsOfBroker).
//
// mode: immediate | regular | red (D33): immediate — согласование и
// события сотрудников, ≤ 5 минут; regular — перевозка, копится в окна
// notifications.client_digest_times (09:00/16:00 Europe/Moscow, не
// больше notifications.max_regular_per_day в сутки, пустого письма
// нет); red — вне окон и лимитов, антишторм 10-мин дедупликация +
// notifications.red_max_per_hour.
//
// status: pending | sent | failed | skipped (skipped = not_configured /
// not_allowlisted / no_email — целевое «не отправлено и не будет»).
// windowKey — окно regular-письма и дайджеста «yyyy-mm-dd:HH:MM»
// в поясе notifications.timezone; dedupKey @unique — защита от дублей
// (одиночные: type:kind:recipient:target:10-мин окно; дайджест:
// digest:kind:recipient:дата:окно) и от повторного прогона диспетчера.
//
// eventId — Activity.id без FK: событие может быть каскадно удалено
// вместе со сделкой, журнал отправок (DF-04) должен это пережить.
model Notification {
  id            String    @id @default(cuid())
  recipientKind String
  recipientId   String?
  // Снимок адреса на момент постановки в очередь: письмо уходит по адресу
  // из правила (адресат-человек либо фолбэк компании); смена email
  // получателем историю отправок не переписывает (паттерн actorName).
  toAddress     String
  channel       String    @default("email")
  mode          String
  eventId       String?
  type          String
  subject       String
  body          String
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  sentAt        DateTime?
  lastError     String?
  providerId    String?
  windowKey     String?
  dedupKey      String    @unique
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([recipientKind, recipientId, createdAt])
}

// Настройки доставки на получателя (карточка DF-03): по умолчанию
// email включён — строка может отсутствовать (отсутствие = включён).
// Управление preference'ами — следующий релиз (DF-04/личные кабинеты),
// модель и чтение правилами появляются здесь, чтобы не расширять
// схему дважды.
model NotificationPreference {
  id            String  @id @default(cuid())
  recipientKind String
  recipientId   String
  channel       String
  enabled       Boolean @default(true)

  @@unique([recipientKind, recipientId, channel])
}

// ─── DF-17: справочники и курсы (D37, O-10) ──────────────────────────
// Универсальная таблица небольших справочников: страны (ISO 3166-1),
// валюты (ISO 4217), упаковка (Рек. 21 ЕЭК ООН), условия поставки
// (Инкотермс 2020). Места — отдельная таблица (DF-17B), ТН ВЭД —
// своя (DF-17C). Источники и условия использования каждого dir —
// docs/REFERENCES-SOURCES.md (IC-16).
//
// dir: country | currency | packaging | incoterm (whitelist lib/ref.ts).
// code — стабильный код из источника: НЕ меняется после использования
// (API-правки кода нет вообще; подпись name переопределяется). Валюты
// и Инкотермс хранят в meta структурированные данные (minorUnits /
// правила таможенной стоимости — черновик до утверждения брокером,
// O-12), литералов перечней в коде нет (IC-16).
model RefItem {
  id        String   @id @default(cuid())
  dir       String
  code      String
  // Русская подпись; null-переопределения нет — справочник заполняется
  // сидом с именами источника, мастер правит подписи здесь.
  name      String
  nameEn    String?
  meta      Json?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([dir, code])
  @@index([dir, isActive])
}

// Официальные курсы Банка России (DF-17): ежедневный импорт проходом
// диспетчера (lib/cbr.ts — XML_daily.asp, windows-1251, запятая как
// десятичный разделитель, номинал). value — рублей за nominal единиц
// (Decimal(14,4) — формат источника). (date, code) @unique — импорт
// идемпотентен: повторный проход не дублирует; при сбое расчёты (DF-19)
// берут последний известный курс с пометкой даты.
model CurrencyRate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  code      String
  nominal   Int      @default(1)
  value     Decimal  @db.Decimal(14, 4)
  createdAt DateTime @default(now())

  @@unique([date, code])
  @@index([code, date])
}

// ─── DF-17C: справочник ТН ВЭД ЕАЭС (ЕТТ) ────────────────────────────
// Карточка DF-17C: код 10 знаков, наименование, ставка ЕТТ текстом;
// импорт скриптом БЕЗ удаления старого (история действия: старые сделки
// хранят код и редакцию, по которой он выбран). Единственный импортёр —
// scripts/import-hs.ts (аналог IC-16 для RefItem), данные —
// scripts/ref-data/hs/tnved-tws.json (снапшот открытой выгрузки
// tws.by/tws/tnved/download/excel — см. docs/REFERENCES-SOURCES.md, hs).
//
// Источник отдаёт только 10-значные листовые позиции (13 294), поэтому
// level = 10 у всех записей; поле — по карточке (иерархия 2/4/6
// восстанавливается префиксом кода, наименования-пути несут контекст).
// unit (доп. единица) в выгрузке отсутствует — nullable, доезжает из
// официальных PDF ходовых групп позже (не блокер, карточка DF-17C).
//
// Ставка ЕТТ (etdDutyText) — ПОДСКАЗКА брокеру рядом с кодом, НЕ
// подставляется автоматически: он вносит ставку из своей Альты (DF-18).
model HsCode {
  id          String    @id @default(cuid())
  code        String
  // Наименование-путь источника («родитель / … / собственное имя») —
  // поиск по названию идёт по всему пути (контекст группы виден).
  name        String
  level       Int
  unit        String?
  etdDutyText String?
  // Окно действия редакции: validFrom — дата данных источника; при
  // импорте новой редакции предыдущая закрывается validTo = её дате
  // (записи не удаляются — история действия, карточка DF-17C).
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date
  sourceRev   String

  @@unique([code, sourceRev])
  @@index([code])
  @@index([sourceRev, validTo])
}

// Журнал импортов ТН ВЭД (DF-17C): одна строка на редакцию — версия,
// дата импорта, источник, число позиций. version @unique — повторный
// импорт той же редакции НЕ дублирует ни записи, ни журнал.
model HsImport {
  id         String   @id @default(cuid())
  version    String   @unique
  source     String
  itemCount  Int
  importedAt DateTime @default(now())

  @@index([importedAt])
}

// ─── DF-19: расчёт таможенных платежей в рублях (D38/D39) ─────────────
// Оценка платежей по условиям поставки, стоимости, фрахту и официальному
// курсу ЦБ РФ. РАСЧЁТ ВОСПРОИЗВОДИМ (D38, инвариант 11): входные данные,
// курсы, запас и версия правил хранятся СНИМКОМ на момент расчёта —
// смена курса в справочнике сохранённые числа не меняет. История версий:
// пересчёт (POST) создаёт новую запись, прежняя остаётся isCurrent=false;
// правки черновика (PUT) — только текущей версии. Валюта сделки в
// эталонных ДТ может не совпадать с валютой счёта (эталон №2: цена EUR,
// счёт TRY) — строки позиций несут СВОЮ валюту (D40: редактируемость).
//
// Цель — ровно одна: лид ИЛИ заявка (инвариант union на TS-уровне, как
// Document/Activity). DF-27 волна 2 (Р-5, D75): при конвертации версии,
// привязанные к согласованному варианту, и текущая версия запроса
// переносятся на заявку с origin='carried_from_lead' — история целиком
// сохраняется и доступна менеджеру/брокеру, клиенту — только актуальный
// результат.
model CustomsCalculation {
  id                 String   @id @default(cuid())
  leadId             String?
  orderId            String?
  // Условие поставки: КОД из справочника DF-17 + место текстом (снимок
  // на момент расчёта; поля Lead/Order — стартовые значения формы).
  // Флаги правил (что добавить/вычесть) читаются из meta справочника —
  // НЕ из кода (D39/O-12); черновые правила (meta.draft) расчёт не
  // применяет — 409 до сида справочников.
  incoterm           String
  incotermPlace      String?
  // Дата расчёта и дата курсов в снимке («курс от <дата>»). Для ТС
  // применяется курс на дату регистрации ДТ — менеджер вводит дату
  // (по умолчанию сегодня); финальные платежи определятся при
  // декларировании, взаиморасчёты — по курсу на дату оплаты (D41).
  calcDate           DateTime
  fxDate             DateTime @db.Date
  // Снимок курсов ЗА ОДНУ единицу валюты (номиналы ЦБ учтены при
  // импорте, lib/cbr.ts): { "USD": { "rate": "73.1275", "date":
  // "2026-05-18", "source": "cbr" | "manual" }, ... } — эталон №2
  // (TRY котируется за 10: в снимке уже 1,75789 за единицу).
  fxRates            Json
  // Запас к курсу, % — СНИМОК настройки customs.fx_reserve_percent на
  // момент расчёта (D41: оценка, не платёж).
  fxReservePercent   Decimal  @default(0) @db.Decimal(5, 2)
  // Расходы, влияющие на ТС (все — в валюте фрахта freightCurrency;
  // разъезжающиеся валюты менеджер приводит к ней сам — D40):
  // freightTotal — фрахт по счёту целиком; freightToArrival — часть
  // ДО места прибытия на территорию ЕАЭС (умолчания: добавляющим
  // терминам — freightTotal, вычитающим — 0); insurance — страхование,
  // если фактически понесено покупателем сверх цены (D43); otherCosts —
  // погрузка/разгрузка, посредники, упаковка.
  freightTotal       Decimal  @db.Decimal(14, 2)
  freightCurrency    String   @default("USD")
  freightToArrival   Decimal? @db.Decimal(14, 2)
  insurance          Decimal  @default(0) @db.Decimal(14, 2)
  otherCosts         Decimal  @default(0) @db.Decimal(14, 2)
  // Вознаграждение брокера за ДТ — согласованная ФИКСИРОВАННАЯ сумма
  // (ответ брокера 30.10.2026). Строка итогов ВНЕ таможенных платежей,
  // в ТС и базы пошлин/НДС не входит (D42).
  brokerFeeRub       Decimal? @db.Decimal(14, 2)
  // Переопределение метода распределения начислений менеджером (D40):
  // { freight: 'weight'|'value', other: 'weight'|'value' } — умолчания
  // по правилам ДТС-1 (перевозка — вес НЕТТО гр. 38, прочие —
  // стоимость); null/частичный Json — правила по умолчанию.
  allocationOverride Json?
  // Версия набора правил (формула, состав базы НДС, трактовка флагов) —
  // константа CUSTOMS_RULES_VERSION (lib/customs.ts); воспроизводимость
  // старого расчёта = снимок входа + эта строка.
  rulesVersion       String
  // Таможенный сбор: снимок расчёта по шкале CustomsFeeScale либо
  // ручной ввод до утверждения шкалы (feeManual).
  feeRub             Decimal? @db.Decimal(14, 2)
  feeManual          Boolean  @default(false)
  // Итоги расчёта: { customsValueTotal, dutyTotal, addDutyTotal,
  // vatTotal, feeRub, paymentsTotal, brokerFeeRub, grandTotal, ... }
  // — дублируют сумму строк для списков/печати без пересчёта.
  totals             Json
  // Актуальная версия (последний пересчёт); история — isCurrent=false,
  // правки (PUT) — только текущей.
  isCurrent          Boolean  @default(true)
  // ─── DF-27 волна 2 (Р-5) ─────────────────────────────────────
  // Расчёты, которые велись в контуре конкретного варианта; при
  // конвертации переносятся на заявку вместе с историей версий.
  quoteOptionId      String?
  // null = собственный расчёт; 'carried_from_lead' = перенесён при
  // конвертации (Р-5) — происхождение сохраняется без перезаписи истории
  origin             String?
  createdById        String?
  // Снимок имени автора (паттерн actorName: история дольше справочника)
  createdByName      String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  lead        Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteOption QuoteOption?        @relation(fields: [quoteOptionId], references: [id], onDelete: SetNull)

  items CustomsCalculationItem[]
  // DF-27: строки расчёта вариантов, ссылающиеся на версию (статья
  // customs) — снимок значений на момент расчёта варианта
  calcLines QuoteOptionCalcLine[]
  // DF-27 волна 2 (D73, §8.4): информационные пересчёты — append-only
  fxRecalcs CustomsFxRecalc[]
  // DF-27 волна 2 (Р-3): снимки согласования, зафиксировавшие эту версию
  approvalSnapshots LeadApprovalSnapshot[]

  @@index([leadId, createdAt])
  @@index([orderId, createdAt])
  @@index([isCurrent])
}

// Строка расчёта по одному коду ТН ВЭД: стоимость товара и вес НЕТТО
// (гр. 38 ДТ — распределение перевозки по весу считаем по НЕТТО,
// ответ брокера 30.10.2026, D40), проценты — СНИМОК ответа брокера
// (DF-18) на момент расчёта, результаты — в рублях по снимку курса.
// brokerItemId — ссылка на строку ответа брокера БЕЗ FK (паттерн
// actorId: оценка брокера перезаписывается deleteMany/createMany,
// id живут короче расчёта; связь — для подсказки, не для каскадов).
model CustomsCalculationItem {
  id             String   @id @default(cuid())
  calculationId  String
  // Порядок строки — как внесено (отображение и итоги стабильны)
  sortOrder      Int
  brokerItemId   String?
  hsCode         String
  goodsValue     Decimal  @db.Decimal(14, 2)
  goodsCurrency  String
  netWeightKg    Decimal  @db.Decimal(12, 3)
  // Снимок процентов брокера (null = «не указано»; ставка-строка
  // rateNote из DF-18 в автрасчёт не попадает — isManualRate,
  // lib/brokers.ts: такая строка правится менеджером вручную)
  dutyPercent    Decimal? @db.Decimal(5, 2)
  addDutyPercent Decimal? @db.Decimal(5, 2)
  vatPercent     Decimal? @db.Decimal(5, 2)
  // Результаты в рублях (Decimal, RULES 2.15): ТС позиции (стоимость
  // по курсу + доля начислений − доля вычетов), пошлина/доп. пошлина
  // (ТС × %), НДС ((ТС + пошлина + доп. пошлина) × %, сбор в базу НЕ
  // входит — подтверждено эталонами №1–№3), allocatedCosts — доля
  // дополнительных начислений позиции (сумма по кодам = базе).
  customsValue   Decimal  @db.Decimal(14, 2)
  duty           Decimal  @default(0) @db.Decimal(14, 2)
  addDuty        Decimal  @default(0) @db.Decimal(14, 2)
  vat            Decimal  @default(0) @db.Decimal(14, 2)
  allocatedCosts Decimal  @default(0) @db.Decimal(14, 2)

  calculation CustomsCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([calculationId, sortOrder])
}

// Шкала таможенных сборов «диапазон ТС → сбор» (D39: утверждает брокер;
// с 01.01.2026 — ПП РФ от 28.11.2024 № 1637 в ред. ПП от 23.10.2025
// № 1638, подтверждено эталонами №2–№3: скобка 2,7–4,2 млн → 18 465 ₽).
// Данные — справочные (IC-16): сид scripts/ref-data/customs-fees.ts,
// импортирует ТОЛЬКО scripts/seed.ts; смена редакции = новая дата
// validFrom (обязательное поле — шкала индексируется), полная замена
// строк редакции при пересиде. Сбор считается от ОБЩЕЙ ТС одной
// ступенью; upperBound null — открытая верхняя скобка.
model CustomsFeeScale {
  id         String   @id @default(cuid())
  validFrom  DateTime @db.Date
  upperBound Decimal? @db.Decimal(14, 2)
  feeRub     Decimal  @db.Decimal(14, 2)
  sortOrder  Int      @default(0)

  @@index([validFrom])
}

// ─── DF-27 волна 2 (Р-3): неизменяемая печатная редакция заявки ────
// Каждая значимая правка заявки после согласования формирует НОВУЮ
// редакцию (append-only): содержимое, файл и hash после создания
// НЕ меняются; исправление — новая редакция, старые остаются историей.
// leadSnapshot — полный набор полей заявки, включённых в печатную форму;
// contentHash — хеш содержимого редакции (подтверждение по revisionId +
// contentHash, Р-3); renderedFileId — ссылка на Document (паттерн без
// FK, как actorId: удаление документа не портит историю редакции).
model LeadPrintRevision {
  id             String   @id @default(cuid())
  leadId         String
  // Порядковый номер редакции внутри заявки (1, 2, …)
  seq            Int
  // Полный снимок полей заявки, включённых в печатную форму, на момент
  // создания редакции — структура v:1, читатели толерантные
  leadSnapshot   Json
  renderedFileId String?
  // Хеш содержимого сформированной редакции (sha256 канонического JSON)
  contentHash    String
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())

  lead           Lead                          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  confirmations  LeadPrintRevisionConfirmation[]
  approvalSnapshots LeadApprovalSnapshot[]

  @@unique([leadId, seq])
  @@index([leadId, createdAt])
}

// Подтверждение печатной редакции одной из сторон (Р-3): клиент и
// менеджер подтверждают ОДНУ И ТУ ЖЕ редакцию по revisionId + contentHash;
// подтверждение менеджера не заменяет подтверждение клиента и наоборот.
// Подтверждения не перезаписываются и не удаляются; при новой редакции
// подтверждения старой не переносятся.
model LeadPrintRevisionConfirmation {
  id          String   @id @default(cuid())
  revisionId  String
  // 'client' | 'manager' — одна запись на роль на редакцию
  partyRole   String
  actorId     String?
  actorName   String
  confirmedAt DateTime @default(now())
  // Как именно подтвердили: действие в кабинете / фиксация сотрудником
  method      String
  comment     String?

  revision LeadPrintRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, partyRole])
  @@index([revisionId, confirmedAt])
}

// ─── DF-27 волна 2 (D73, §8.4): информационный пересчёт курса ─────
// Результат пересчёта — НОВАЯ append-only запись, а не перезапись
// версии: нормативный слой, fxDate/fxRates и суммы версии не меняются;
// пересчёты менеджера и клиента независимы и не перезаписывают друг
// друга (денежный слой — не обязательство, D73). Эндпоинтов правки и
// удаления нет; удаление записи — только каскадом с расчётом.
model CustomsFxRecalc {
  id            String   @id @default(cuid())
  calculationId String
  // Кто пересчитал: 'manager' | 'client' — пересчёты независимы
  actorRole     String
  actorId       String?
  actorName     String
  // Валюта представления (новый параметр контракта по D73)
  currency      String
  // Выбранная дата курса (снимок курсов за единицу валюты, lib/cbr.ts)
  fxDate        DateTime @db.Date
  fxRates       Json
  // Пересчитанные таможенная стоимость и суммы платежей по позициям
  // и итоги (чистая функция — customs-server); нормативный слой версии
  // не затрагивается
  totals        Json
  createdAt     DateTime @default(now())

  calculation CustomsCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([calculationId, createdAt])
}

// ─── DF-27 волна 2 (D73, §8.6): окончательные платежи по ДТ ────────
// Вносится сотрудником по факту декларирования: дата подачи ДТ + суммы
// по видам платежей (в валютах уплаты). Append-only: новая запись
// прежние не меняет, эндпоинтов правки/удаления нет; отображается
// последняя запись, история доступна развёрнуто (Р-5: клиенту — только
// актуальный результат, без журнала).
model CustomsFinalPayment {
  id        String   @id @default(cuid())
  orderId   String
  // Дата подачи ДТ — по применимым правилам и данным на эту дату
  dtDate    DateTime @db.Date
  // Суммы по видам платежей: [{ kind, amount, currency }]
  lines     Json
  note      String?
  actorId   String?
  actorName String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}
