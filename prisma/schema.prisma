generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Остальные модели (LegalEntity, Customer, Contract, Order,
// OrderStageCatalog, OrderStageInstance) начинаются с Дорожки Б —
// намеренно не добавлены здесь, Employee/EmployeeSession нужны раньше
// как часть auth-паттерна (А4+А5; исторический план — docs/archive/).
// ^ Исторический комментарий А4 — с Дорожкой Б (Б1) модели ядра
// добавлены ниже (исторический план — docs/archive/). Скоуп Б1: шесть
// моделей ядра заявки; Lead/QuoteOption/документы/подрядчики/брокеры —
// следующих дорожки, поля-ссылки на них сюда не добавлены, чтобы не
// тянуть миграцию-заглушку.

model Employee {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  // DF-02: контактный email для уведомлений (адресат-человек, DF-03).
  // Nullable: поле необязательное, пустота — «email нет», мусор —
  // не сохраняем (isEmail, паттерн resolveEmail company-users).
  email     String?
  password  String // hashPassword() из src/lib/password.ts
  // JSON-массив, не enum — см. раздел 1а LOGISTICS-ROADMAP.md: точный
  // периметр "начальник отдела" ещё не решён, добавление новой роли
  // позже не должно требовать миграции структуры этого поля.
  roles     String   @default("[\"manager\"]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  sessions       EmployeeSession[]
  // P1-01: назначение ответственным менеджером (обратные связи
  // Lead/Order). Назначение НЕ блокирует деактивацию — проверка
  // isActive живёт в API смены ответственного.
  assignedLeads  Lead[]            @relation("LeadAssignee")
  assignedOrders Order[]           @relation("OrderAssignee")
}

model EmployeeSession {
  id         String   @id @default(cuid())
  employeeId String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([token])
}

// ─── Дорожка Б: ядро заявки (раздел 9 LOGISTICS-ROADMAP.md) ──

model LegalEntity {
  id         String   @id @default(cuid())
  name       String
  // Реквизиты для печатных форм — структура уточняется при генерации
  // документов (роадмап: "не фиксировать точную структуру до реальных форм").
  requisites Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  contracts Contract[]
  orders    Order[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  comment   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // И1: доступ в клиентский кабинет — у ЧЕЛОВЕКА (CustomerUser, DF-02A):
  // логин — телефон пользователя, пароль задаёт менеджер через
  // POST /api/admin/customers/[id]/access (саморегистрации в MVP нет —
  // без SMS-верификации «регистрация на любой номер» открывала бы чужие
  // заявки). Пароль на КОМПАНИИ (Customer.password) удалён contract-
  // миграцией df_03_contract — страховка отката пережила релиз 0.6.4,
  // вход давно идёт через authenticateCustomerLogin (company-users.ts).

  contracts Contract[]
  orders    Order[]
  leads     Lead[]
  sessions  ClientSession[]
  users     CustomerUser[]
}

model Contract {
  id            String    @id @default(cuid())
  legalEntityId String
  customerId    String
  // Сквозной номер рамочного договора (Б4: заявка = "<договор>-<порядковый>",
  // например "17-1"). Int, а не String: выдаётся системой последовательно
  // (max+1 с retry-петлёй на P2002), как number у заказов предыдущего проекта.
  number        Int       @unique
  signedAt      DateTime?
  createdAt     DateTime  @default(now())

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  orders      Order[]

  // Рамочный договор — ровно один на пару клиент+юрлицо (роадмап,
  // разделы 4 и 8.2). Уникальность на уровне БД заодно закрывает гонку
  // двух одновременных «первых заявок» одной пары (см. lib/orders.ts).
  @@unique([customerId, legalEntityId])
  @@index([customerId])
  @@index([legalEntityId])
}

model Order {
  id               String   @id @default(cuid())
  // Составной номер "договор-порядковый" (Б4), например "17-1".
  // Денормализован намеренно (роадмап: "формируется автоматически"):
  // обе части (contract.number, numberInContract) неизменяемы после
  // создания, так что рассинхрона не бывает, а печатные формы заявки
  // всегда имеют готовый номер без сборки через include.
  number           String   @unique
  numberInContract Int
  contractId       String
  legalEntityId    String
  customerId       String
  // Связь с лидом воронки (В1): заявка из конвертации (В4) знает свой
  // источник, «ручные» заявки из Б — leadId null (осознанно допустимо,
  // роадмап). Удаление лида с заявкой невозможно (API В2 откажет 409),
  // а удаление заявки лид не убивает. @unique: один лид → максимум
  // одна заявка.
  leadId           String?  @unique
  // Справочные поля заявки (роадмап, раздел 4/6): Инкотермс — подсказка
  // менеджеру, не управляет логикой; ТН ВЭД — текстовое поле с первого
  // дня как точка расширения Phase 2 (дерево/валидация позже).
  incoterm         String?
  cargoProfile     String   @default("standard") // standard | oversized | dangerous
  hsCode           String?
  // Ручной верхнеуровневый статус (роадмап 8.1: менеджер переводит
  // осознанно, этапы не диктуют его автоматически).
  status           String   @default("calculating") // calculating | confirmed | in_progress | completed | cancelled
  // ─── Ж1: суть заявки ────────────────────────────────────────────
  // Заявка — источник правды после конвертации (принцип переработки):
  // груз и условия копируются с лида СНИМКОМ, дальнейшие правки лида
  // заявку не меняют. cargoInfo — та же форма бланка, что у Lead
  // (хелперы buildLeadCargo/readLeadCargo общие); quoteSnapshot —
  // снимок выбранного варианта расчёта (описание, виды транспорта,
  // цена, срок, ориентир). Оба поля nullable: у ручных заявок (Б3,
  // без лида) они заполняются PATCH'ем (Ж1) или остаются пустыми.
  cargoInfo        Json?
  quoteSnapshot    Json?
  createdAt        DateTime @default(now())
  // P1-01: дата последнего изменения — маркер «заявка без движения»
  // (сортировка «давно без движения», фильтры внимания). @default(now())
  // обязателен: непустая таблица на миграции получает честную точку
  // отсчёта (тот же приём, что updatedAt у Lead — Ж5).
  updatedAt        DateTime @default(now()) @updatedAt
  // P1-01: ответственный менеджер заявки. Конвертация В4 переносит с
  // лида (без ответственного на лиде — тот, кто конвертировал); ручная
  // заявка Б3 — создатель. null = не назначена (например, запрос из
  // кабинета, конвертированный «в общий котёл»). SetNull — как у
  // подрядчика на этапе: API-удаления сотрудника нет, страховка от
  // ручных операций в БД; история назначений живёт в Activity-снимках.
  assignedToId     String?

  // ─── P1-03: маршрут и груз — те же колонки, что на Lead (см. там) ──
  // Заявка — источник правды после конвертации: копируется с лида
  // снимком (convert), правится PATCH (Ж1) вместе с cargoInfo.
  originCity         String?
  originCountry      String?
  destinationCity    String?
  destinationCountry String?
  transportType      TransportType?
  readyDate          DateTime?
  weightKg           Decimal?       @db.Decimal(12, 3)
  volumeM3           Decimal?       @db.Decimal(10, 3)
  placesCount        Int?

  contract    Contract             @relation(fields: [contractId], references: [id])
  legalEntity LegalEntity          @relation(fields: [legalEntityId], references: [id])
  customer    Customer             @relation(fields: [customerId], references: [id])
  lead        Lead?                @relation(fields: [leadId], references: [id])
  assignee    Employee?            @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  stages      OrderStageInstance[]
  activities  Activity[]
  // Д (роадмап 5а): брокеры заявки — полная видимость сделки целиком,
  // не per-stage (в отличие от подрядчиков). Переносится из LeadBroker
  // при конвертации В4; менеджер может добавить/снять и после.
  brokers     OrderBroker[]
  // Е (роадмап 5): документы заявки — обмен клиент/брокер/менеджер
  // внутри сервиса. Внутренние (isInternal) наружу не отдаются.
  documents   Document[]

  @@unique([contractId, numberInContract])
  @@index([status])
  @@index([customerId])
  @@index([assignedToId])
  @@index([updatedAt])
  @@index([transportType])
  @@index([originCountry])
  @@index([destinationCountry])
}

model OrderStageCatalog {
  // Справочник типовых этапов — расширяемый (роадмап, раздел 3).
  id          String  @id @default(cuid())
  code        String  @unique // export_pickup | export_customs | loading | transport | import_customs | final_delivery | ...
  name        String
  // Порядок по умолчанию при подстановке/предложении менеджеру.
  order       Int
  // true — подставляется в каждую заявку автоматически, менеджер не
  // может удалить (защита и в API, и в UI).
  isMandatory Boolean @default(false)
}

model OrderStageInstance {
  // Конкретный этап конкретной заявки. Ссылка на каталог — по code
  // (роадмап, раздел 9): isMandatory берётся из каталога живым lookup'ом,
  // а не снимком на момент добавления — правило "обязательное нельзя
  // удалить" следует за актуальным состоянием справочника.
  id           String    @id @default(cuid())
  orderId      String
  stageCode    String
  sequence     Int
  status       String    @default("not_started") // not_started | in_progress | done | problem
  // Исполнитель этапа (Дорожка Г, роадмап 3/9): подрядчик назначается
  // на ЭТАП, а не на заявку целиком — принципиальное отличие от брокера
  // (5а: тот подключается к сделке с этапа расчёта и видит её целиком,
  // брокерские связи — Дорожка Д). null = ещё не назначен или снят;
  // plannedDate/actualDate существуют с Б1, с Г активируются: план
  // ставит менеджер при назначении (Г3), факт проставляет сервер
  // при done (Г4).
  contractorId String?
  plannedDate  DateTime?
  actualDate   DateTime?
  createdAt    DateTime  @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // SetNull явно: прямое удаление подрядчика в БД не тянет за собой
  // этапы — назначения обнуляются, история этапов жива (API-удаления
  // подрядчика нет вовсе, Г3 — это страховка от ручных операций в БД).
  contractor Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([stageCode])
  @@index([contractorId])
}

// ─── Воронка (Дорожка В, В1) ────────────────────────────────────────
// Lead/QuoteOption добавлены с Дорожкой В; Order получил опциональную
// ссылку leadId (ручные заявки без лида — законны, null).

// P1-03: тип перевозки — справочник колонок (не Json): по нему
// фильтруются списки («Китай → Москва, Море») и заполняется печатная
// форма (бланк п.3). Коды английские (стабильные в API/фильтрах),
// русские подписи — в lib/route-fields.ts (TRANSPORT_TYPE_LABELS).
enum TransportType {
  auto
  rail
  sea
  air
  multimodal
}

// P1-04 (деньги, RULES 2.15): все денежные поля — Decimal + код валюты;
// float и «рубли по умолчанию» запрещены. Коды английские (стабильные
// в API), русские подписи и знаки — в lib/money.ts (formatMoney —
// единственная точка форматирования денег).
enum Currency {
  RUB
  USD
  EUR
  CNY
}

// Режим НДС цены варианта (P1-04): метка цены, НЕ расчёт — маржа/НДС
// не вычисляются и не отдаются наружу (D19, RULES 2.15). Подписи —
// lib/money.ts (VAT_MODE_LABELS).
enum VatMode {
  WITH_VAT
  WITHOUT_VAT
  ZERO_VAT
}

model Lead {
  id           String   @id @default(cuid())
  // Клиент опционален: лид рождается на этапе запроса, когда клиента
  // в справочнике может ещё не быть (обращение с сайта/по телефону).
  // rawContact хранит анкету как есть; Customer рождается из неё при
  // конвертации (В4), тогда проставляется customerId.
  customerId   String?
  // Черновая анкета { name, phone?, email? } — Json, а не поля: до
  // конвертации структура «сырая» (телефон может быть иностранным,
  // нормализация — только при рождении Customer, см. lib/phone.ts).
  rawContact   Json?
  // Груз/вес/объём/маршрут — свободный Json на этапе запроса.
  cargoInfo    Json?
  // Ручной верхнеуровневый статус воронки (роадмап 8.1 — статусами
  // управляет человек, не этапы): new | calculated | won | lost.
  // «won» вручную поставить нельзя (API В2: 409) — только конвертацией
  // в заявку (В4). Первый добавленный вариант расчёта (В3) переводит
  // new → calculated автоматически.
  status       String   @default("new")
  lostReason   String?
  // И1: откуда родился лид — 'manual' (менеджер, В2) | 'cabinet'
  // (запрос из клиентского кабинета). С default, чтобы db:push на
  // непустой таблице прошёл без разрушения: все существующие лиды
  // созданы руками менеджеров — честное значение по умолчанию.
  source       String   @default("manual")
  createdAt    DateTime @default(now())
  // Ж5 «Требует внимания»: дата последнего изменения — маркер «лид без
  // движения» (порог 3 дня). @default(now()) обязателен: db:push на
  // непустой таблице должен заполнить колонку у существующих строк
  // (счётчик простоя у них пойдёт от момента миграции — честно). Каждый
  // update лида трогает колонку автоматически (@updatedAt); добавление
  // /правка/удаление варианта дополнительно трогает лид явно (В3),
  // чтобы «движением» считалась и работа с вариантами без смены
  // статуса.
  updatedAt    DateTime @default(now()) @updatedAt
  // P1-01: ответственный менеджер лида. При создании (В2) — текущий
  // сотрудник; запрос из кабинета (И1) рождается без ответственного.
  // null = не назначен / снят. SetNull — как у подрядчика на этапе:
  // API-удаления сотрудника нет, страховка от ручных операций в БД;
  // история назначений живёт в Activity-снимках.
  assignedToId String?

  // ─── P1-03: маршрут и груз — поля, а не только JSON ─────────────
  // Структурированные поля бланка: фильтры списков, сортировки и
  // печатная форма (п.3/17/18/20) читают колонки; cargoInfo хранит
  // «остальное» (v: 1). Миграция переносит из Json: from/to (первая
  // запятая = граница «страна, город»), transportType (словарь
  // Авиа→air…), shipDate → readyDate, вес/объём/места — и удаляет эти
  // ключи из Json. Decimal — точность весов/объёмов (P1-04 принесёт
  // Decimal и деньгам — D19/RULES 2.15).
  originCity         String?
  originCountry      String?
  destinationCity    String?
  destinationCountry String?
  transportType      TransportType?
  readyDate          DateTime?
  weightKg           Decimal?       @db.Decimal(12, 3)
  volumeM3           Decimal?       @db.Decimal(10, 3)
  placesCount        Int?

  customer   Customer?     @relation(fields: [customerId], references: [id])
  assignee   Employee?     @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  options    QuoteOption[]
  order      Order?
  activities Activity[]
  // Д (роадмап 5а): брокеры консультируют сделку уже на расчёте —
  // связь на уровне лида, до рождения заявки. При конвертации В4
  // переносится в OrderBroker автоматически («переживает конвертацию,
  // не заводится заново» — формулировка роадмапа).
  brokers    LeadBroker[]
  // Е (роадмап 5): документы могут родиться ещё на лида — например,
  // предварительный инвойс для расчёта пошлины брокером; при
  // конвертации В4 переносятся на заявку (leadId → orderId).
  documents  Document[]

  @@index([status])
  @@index([customerId])
  @@index([updatedAt])
  @@index([assignedToId])
  @@index([transportType])
  @@index([originCountry])
  @@index([destinationCountry])
}

model QuoteOption {
  // Вариант расчёта лида (В3 — API вариантов): один расчёт = один
  // способ доставки (описание + виды транспорта + цена + сроки + чем
  // хорош). Менеджер выбирает ровно один вариант на лид (isSelected,
  // выбор нового снимает прежний — инвариант на уровне API В3).
  id             String   @id @default(cuid())
  leadId         String
  description    String
  transportModes Json?
  // P1-04 (D19, RULES 2.15): цена клиенту (с нашей наценкой) и
  // себестоимость — РАЗДЕЛЬНЫЕ данные. Цена уходит в снимок заявки
  // и клиентские проекции; costEstimate — только сотрудникам
  // (наружу не выходит никогда, D3); маржа не вычисляется.
  price          Decimal  @db.Decimal(14, 2)
  currency       Currency @default(RUB)
  vatMode        VatMode  @default(WITHOUT_VAT)
  // Себестоимость (внутренняя, nullable — «ещё не посчитана»)
  costEstimate   Decimal? @db.Decimal(14, 2)
  costCurrency   Currency @default(RUB)
  etaDays        Int
  // Чем вариант лучше других: speed | cost | safety.
  priorityFit    String
  isSelected     Boolean  @default(false)
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ─── Подрядчики (Дорожка Г) ────────────────────────────────────────
// Подрядчическая воронка (роадмап 2): ContractorLead (кандидат,
// квалификация) → Contractor (пул). Contractor — глобальный
// справочник, НЕ разовая привязка и НЕ роль Employee (роадмап 1:
// урезанный ЛК — отдельный кабинет с собственной сессией, задел А5).

model Contractor {
  // Справочник пула (роадмап 2): квалифицировали один раз —
  // используется во всех заявках, пока не исключён из пула.
  id               String    @id @default(cuid())
  companyName      String
  // Логин урезанного ЛК (Г4) — тот же паттерн, что у Employee (А5).
  phone            String    @unique
  // hashPassword() из src/lib/password.ts — стартовый пароль задаёт
  // менеджер при переводе кандидата в пул (Г2), смена — PATCH (Г3).
  password         String
  // Виды транспорта/направления — Json, структуру не фиксируем до
  // реальных форм (роадмап 9); допуски (негабарит/опасные, фильтр по
  // CargoProfile) — Phase 2, добавятся внутрь Json без миграции
  // (роадмап 6 — «точка расширения на старте»).
  competencies     Json?
  // Контактное лицо/email/реквизиты — сырой Json по образцу rawContact
  // лида (В1): до реальных форм структуру сознательно не фиксируем.
  contactInfo      Json?
  // Факт договора с подрядчиком — только номер + дата (тарифы из
  // Приложений, УПД и взаиморасчёты — финансовая модель, осознанно
  // вне MVP, роадмап 9). Прообраз из разбора S13: ИП Сванишвили,
  // договор 0105/1-СВ.
  contractNumber   String?
  contractSignedAt DateTime?
  // Пул: false = не назначается на новые этапы (Г3 отклонит), но
  // существующие назначения и вход в ЛК живут — мягкое исключение
  // (иначе сорванные перевозки). API-удаления подрядчика нет вовсе
  // (Г3): история заявок не должна терять исполнителей.
  isActive         Boolean   @default(true)
  comment          String?
  createdAt        DateTime  @default(now())

  sessions   ContractorSession[]
  lead       ContractorLead?
  stages     OrderStageInstance[]
  activities Activity[]

  @@index([isActive])
}

model ContractorSession {
  // Сессия урезанного ЛК подрядчика — по образцу EmployeeSession
  // (А5: своя сессия на каждый тип внешнего пользователя, не роль
  // в общей таблице пользователей).
  id           String   @id @default(cuid())
  contractorId String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([token])
}

model ContractorLead {
  // Кандидат в пул (роадмап 2): свой чек-лист квалификации — НЕ копия
  // клиентской воронки один в один, статусы свои.
  id           String   @id @default(cuid())
  companyName  String
  // Черновая анкета кандидата (контакты/что возит/зоны/источник) —
  // толерантный Json по образцу rawContact лида (В1): API структуру
  // не валидирует, известные ключи UI показывает по меткам (Г5).
  rawInfo      Json?
  // Ручные статусы (симметрия 8.1 — решает человек, не триггер):
  // new | qualifying | contracted | rejected. «contracted» руками
  // не ставится — только рождением Contractor в транзакции (Г2),
  // как «won» у лида (В2/В4); терминален, повторный 409.
  status       String   @default("new")
  // Причина отказа — обязательна при rejected (симметрия lostReason).
  rejectReason String?
  // Рождённый подрядчик: 1:1 (@unique), связь проставляется в
  // транзакции перевода contracted (Г2) и не рвётся.
  contractorId String?  @unique
  createdAt    DateTime @default(now())
  // Ж5: маркер «без движения» по образцу Lead.updatedAt — экран
  // внимания сейчас смотрит только клиентские лиды, колонка ставится
  // сразу, чтобы вторая воронка не требовала новой миграции, когда
  // до неё дойдёт очередь (зеркальный комментарий Lead).
  updatedAt    DateTime @default(now()) @updatedAt

  contractor Contractor? @relation(fields: [contractorId], references: [id])

  @@index([status])
  @@index([updatedAt])
}

// ─── И1: сессия клиентского кабинета ───────────────────────────
// По образцу EmployeeSession (А5) и ContractorSession (Г4): своя
// сессия на каждый тип внешнего пользователя, не роль в общей
// таблице (роадмап, раздел 1 — «три портала, не три роли»).
model ClientSession {
  id         String   @id @default(cuid())
  customerId String
  // DF-02A: сессия конкретного человека (D34). Nullable — переходный
  // период: сессии, созданные миграцией df_02a_company_users, userId
  // получают сразу (привязаны к основному пользователю компании);
  // null остаётся возможен только в окне деплоя (код ещё не пишет
  // пользователя) и трактуется как сессия компании.
  userId     String?
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     CustomerUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([token])
  @@index([userId])
}

// ─── DF-02A: пользователь клиентской компании (D34, пересмотр P1-07) ──
// У компании несколько личных входов; пользователь кабинета — контакт
// с признаком «есть вход» (P1-07): параллельную модель контактов НЕ
// создаём, name/phone/email живут здесь. password = null — контакт
// без входа (доступ выдаёт менеджер). Пароль — hashPassword() из
// src/lib/password.ts; при выдаче/смене пароля хеш переносится в
// CustomerUser (lib/company-users.ts), старое поле Customer.password
// остаётся до contract-релиза (docs/DEPRECATIONS.md).
// phone — БЕЗ @unique (по образцу Customer.phone): уникальность защищает
// lib/company-users.ts (409 внутри компании, 409 против пользователей
// других компаний — второй вход с тем же телефоном не сработал бы), а
// вход ищет findFirst по самому старому (детерминированность сохранена).
model CustomerUser {
  id          String    @id @default(cuid())
  customerId  String
  name        String
  phone       String?
  email       String?
  password    String?
  // Основной пользователь компании — перенос старого входа компании
  // (миграция df_02a_company_users). Один на компанию (защита в
  // lib/company-users.ts); деактивации не подлежит — доступ компании
  // целиком закрывается деактивацией компании (Customer.isActive).
  isPrimary   Boolean   @default(false)
  // Деактивация = доступ закрыт для ЭТОГО человека (паттерн компании
  // И1): живые сессии пользователя гаснут немедленно
  // (lib/company-users.ts), вход деактивированного — 403 после сверки
  // пароля.
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions ClientSession[]

  @@index([customerId])
  @@index([phone])
}

// ─── Дорожка Д: брокеры (роадмап 5а) ────────────────────────────────
// Брокер подключается к сделке ЦЕЛИКОМ — на уровне лида (с этапа
// расчёта) и заявки (после конвертации), а не к отдельному этапу:
// стоимость оформления декларации входит в сумму варианта расчёта,
// то есть брокер нужен ДО появления заявки. Видимость — «заявка
// целиком», не per-stage (принципиальное отличие от подрядчика, Г).
// Все таблицы новые — db:push на живой базе не разрушающий.

model Broker {
  // Справочник привлечённых таможенных представителей (роадмап 1/6:
  // штатный/привлечённый — атрибут isInHouse, не отдельная модель;
  // «экран назначить штатного» на старте не реализуем).
  id          String   @id @default(cuid())
  companyName String
  // Бывший логин урезанного ЛК (Д) — сегодня phone остаётся СПРАВОЧНЫМ
  // телефоном компании; вход — у человека (BrokerUser.phone @unique,
  // DF-02A). Уникальность оставлена: номер компании не должен дублироваться.
  phone       String   @unique
  // DF-02: контактный email компании брокера для уведомлений
  // (адресат-человек живёт в BrokerUser.email, DF-03; это поле —
  // общий адрес компании, фолбэк recipientsOfBroker).
  email       String?
  // Пароль компании (Broker.password) удалён contract-миграцией
  // df_03_contract: вход через authenticateBrokerLogin (BrokerUser),
  // пароль человека задаётся в справочнике пользователей брокера.
  // Штатный/привлечённый — только пометка для справочника, на права
  // не влияет (роадмап 6: «деталь атрибута, не отдельная модель»).
  isInHouse   Boolean  @default(false)
  // Деактивация = доступ закрыт (паттерн клиента И1, не подрядчика):
  // брокер — внешний участник сделки, перестали работать — видеть
  // сделки он больше не должен. Проверка живая в broker-auth (сессия
  // гаснет немедленно), вход деактивированного — 403 после сверки
  // пароля; новые подключения — 409.
  isActive    Boolean  @default(true)
  comment     String?
  // Контактное лицо/email — сырой Json по образцу contactInfo
  // подрядчика (Г1): структуру не фиксируем до реальных форм.
  contactInfo Json?
  createdAt   DateTime @default(now())

  sessions   BrokerSession[]
  users      BrokerUser[]
  leadLinks  LeadBroker[]
  orderLinks OrderBroker[]
}

model BrokerSession {
  // Сессия урезанного ЛК брокера — по образцу EmployeeSession (А5),
  // ContractorSession (Г4) и ClientSession (И1): четвёртый портал,
  // своя кука, не роль в общей таблице (роадмап, раздел 1).
  id        String   @id @default(cuid())
  brokerId  String
  // DF-02A: сессия конкретного человека (D34) — семантика как у
  // ClientSession.userId (null только в окне деплоя).
  userId    String?
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  broker Broker      @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  user   BrokerUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([token])
  @@index([userId])
}

// ─── DF-02A: пользователь брокерской компании (D34) ──────────────────
// Зеркало CustomerUser для брокера (Г1-переиспользование решения:
// одна семантика, две таблицы — справочники разделены, FK на разные
// корни). Отличие: phone @unique — наследование уникальности
// Broker.phone (вход брокера и сегодня детерминирован findUnique).
// password = null — контакт без входа; isPrimary — перенос старого
// входа компании (миграция df_02a_company_users), деактивации не
// подлежит (доступ закрывается на уровне Broker.isActive).
model BrokerUser {
  id          String    @id @default(cuid())
  brokerId    String
  name        String
  phone       String?   @unique
  email       String?
  password    String?
  isPrimary   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  broker   Broker          @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  sessions BrokerSession[]

  @@index([brokerId])
}

model LeadBroker {
  // Связь «брокер консультирует расчёт» (роадмап 5а, черновик 9).
  // ОДНА связь работает и на расчёте, и после конвертации: оценка
  // таможенных платежей (BrokerEstimate, 1:1) живёт здесь и переживает
  // конвертацию — заявка до неё доходит через order.lead (лиды с
  // заявкой не удаляются, В2), так что оценка не теряется и после
  // перехода сделки в исполнение.
  id        String   @id @default(cuid())
  leadId    String
  brokerId  String
  createdAt DateTime @default(now())

  lead     Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  broker   Broker          @relation(fields: [brokerId], references: [id])
  estimate BrokerEstimate?

  // Повторное подключение того же брокера к тому же лиду — ошибка
  // данных, уникальность ловит гонку двойного клика.
  @@unique([leadId, brokerId])
  @@index([brokerId])
}

model OrderBroker {
  // Видимость заявки целиком для брокера (5а) — не per-stage.
  // Рождается конвертацией из LeadBroker (В4) либо прямым подключением
  // менеджером (заявки без лида, подключение после конвертации).
  id        String   @id @default(cuid())
  orderId   String
  brokerId  String
  createdAt DateTime @default(now())

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  broker Broker @relation(fields: [brokerId], references: [id])

  @@unique([orderId, brokerId])
  @@index([brokerId])
}

model BrokerEstimate {
  // То, что брокер обязан сообщить ещё на этапе расчёта (роадмап 5а):
  // (а) ожидаемый размер таможенных платежей и (б) список
  // разрешительных документов. Прямой вход в цену варианта расчёта
  // (QuoteOption.priceEstimate) — но ценообразование отложено
  // (решение И1), поэтому оценка пока внутренняя: менеджер видит её
  // на карточках лида/заявки, клиенту не показывается. Обновлять
  // может только сам брокер (его заявление, не слово менеджера).
  id                  String   @id @default(cuid())
  leadBrokerId        String   @unique
  // P1-04: Decimal по RULES 2.15 (все деньги — Decimal). Валюта —
  // RUB по природе платежа (таможенные платежи РФ, ТК ЕАЭС) —
  // отдельный код валюты не нужен. Nullable — «посчитаю позже»:
  // брокер может сначала сообщить список документов, а сумму потом.
  customsDutyEstimate Decimal? @db.Decimal(14, 2)
  // Список разрешительных документов (строки: «Сертификат
  // соответствия», «Лицензия Минпромторга»…). Json, а не связь со
  // справочником: разрешительная база по ТН ВЭД — Phase 2 (роадмап 6),
  // сейчас это свободный список.
  requiredPermits     Json?
  notes               String?
  createdAt           DateTime @default(now())
  // @updatedAt: оценка уточняется (точные платежи после классификации
  // товара) — менеджеру важно видеть, насколько свежие цифры.
  updatedAt           DateTime @default(now()) @updatedAt

  leadBroker LeadBroker @relation(fields: [leadBrokerId], references: [id], onDelete: Cascade)
}

// ─── Дорожка Е: документооборот внутри сервиса (роадмап 5) ────────
// Обмен документами (товаросопроводительные, правки от брокера)
// внутри платформы, не через внешнюю почту. Участвуют три стороны:
// клиент, брокер и менеджер (подрядчик в контуре Е отсутствует —
// роадмап 5 его не называет). Видимость: любой брокер, связанный с
// заявкой через OrderBroker (или с лидом через LeadBroker, пока
// заявки нет), видит все НЕ внутренние документы этой сделки —
// видимость определяется связью со сделкой, не привязкой к этапу
// (5а, поле stageInstanceId из черновика сознательно убрано).
//
// Все таблицы новые — db:push на живой базе не разрушающий.

model Document {
  id             String   @id @default(cuid())
  // Цель — ровно одна: лид ИЛИ заявка (инвариант на уровне роутов,
  // как у Activity — SQLite не умеет CHECK между колонками).
  // Документ на лиде живёт своей жизнью до конвертации, затем В4
  // переносит его на заявку (leadId → orderId, связь с лидом через
  // order.lead остаётся у сделки, история не рвётся).
  orderId        String?
  leadId         String?
  // Стабильный код типа из DOCUMENT_TYPES (lib/document-constants.ts):
  // accompanying | invoice | permit | customs | contract | application | other
  type           String
  // Человекочитаемое название («Инвойс № INV-123», «Упаковочный лист»).
  title          String
  // Видимость: внутренние документы (подрядческие договоры, тарифы)
  // видны только сотрудникам — клиент и брокер их не видят ни в
  // списках, ни в скачивании. Решение №1 от 14.10.2026 (клиент не
  // видит ставки) + Д (брокер не видит подрядческих условий): без
  // флага менеджеру некуда положить «не для внешних» файл. Симметрия
  // с Activity.isInternal (Ж3). Клиент и брокер создавать внутренние
  // не могут — роуты принуждают false.
  isInternal     Boolean  @default(false)
  // Номер последней версии (кэш для списков без подсчёта версий).
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  order    Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lead     Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([orderId])
  @@index([leadId])
}

model DocumentVersion {
  // Версия документа: файл + автор + комментарий «что изменено и
  // почему» (роадмап 5: проект правится несколько раз до финала,
  // минимум — история версий с датой и автором правки).
  id         String   @id @default(cuid())
  documentId String
  version    Int
  // Метаданные файла: оригинальное имя (санитизированное при загрузке),
  // MIME из белого списка (DOC_ALLOWED_MIME), размер в байтах.
  fileName   String
  mimeType   String
  fileSize   Int
  // Содержимое — в БД, а не в файловой системе: переживает эпизодический
  // диск Vercel, путешествует с базой между песочницами, а скачивание —
  // только через авторизующий роут (публичных URL у файлов нет, тайна
  // видимости держится проверкой кук, а не «неизвестной ссылкой»).
  fileData   Bytes
  // Что изменено и почему — правка от брокера/клиента.
  comment    String?
  // Кто загрузил: сотрудник | клиент | брокер (подрядчика в контуре Е
  // нет). authorName — снимок имени на момент загрузки (лента Ж2).
  authorType String
  authorId   String?
  authorName String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Гонка двух одновременных загрузок версии: обе прочитали
  // currentVersion=1 → обе создают v2 → уникальность ловит одну,
  // роут повторяет с новым номером (паттерн retry Б4).
  @@unique([documentId, version])
  @@index([documentId])
}

// ─── Журнал событий (Дорожка Ж, Ж2) ────────────────────────────────
// Лента «кто что сделал и когда» для заявки, лида и подрядчика.
// Пишется хелпером emitEvent() (lib/events.ts, единая точка с DF-01)
// из write-роутов — прямой create в роутах не допускается, чтобы
// инвариант «не больше одной цели», аудитория и формат актёра
// держались в одном месте.
model Activity {
  id           String   @id @default(cuid())
  // Цель события — не больше одной из трёх (инвариант union
  // ActivityTarget на TS-уровне; SQLite не умеет CHECK-ограничения
  // между колонками). События сделки несут ровно одну цель — удаление
  // цели каскадное: лента удалённой сущности бессмысленна (лид без
  // заявки можно удалить В2, заявки и подрядчики API-удаления не
  // имеют, но страховка от ручных операций в БД та же, что у этапов
  // Г3). ГЛОБАЛЬНЫЕ события возможны без цели — все три колонки
  // nullable (DF-00D: setting_changed — настройка не belongs сделке;
  // читается только staff-лентой).
  orderId      String?
  leadId       String?
  contractorId String?
  // Кто действовал: сотрудник | подрядчик | система. actorName —
  // СНИМОК на момент действия: переименование/деактивация сотрудника
  // или подрядчика историю не переписывают, живой lookup ленте не
  // нужен. actorId — строка без FK по той же причине: справочник
  // живёт короче истории (и не тянет каскады при чистках).
  actorType    String // employee | contractor | system
  actorId      String?
  actorName    String
  // Стабильный код события (словарь ACTIVITY_TYPES в lib/activity.ts)
  // и человекочитаемое описание с деталями — что именно изменилось.
  type         String
  description  String
  // Ж3: приватность события несёт audience (staff-only = «не показывать
  // внешним кабинетам»): read-контексты фильтруют через eventWhereFor
  // (lib/audience.ts), админская лента видит всё. Колонка isInternal
  // удалена contract-миграцией df_03_contract (DEPRECATIONS 0.6.5):
  // двойная правда «isInternal ⇔ audience=={staff}» заменена одной
  // колонкой audience.
  createdAt    DateTime @default(now())

  // DF-01: аудитория события — кому ВИДНО в лентах кабинетов
  // (staff | client | broker; 'contractor' зарезервирован ради
  // замороженного кабинета и в новых событиях не используется —
  // D31, инвариант §1.3 ROADMAP-DEALFLOW). Видимость считает
  // lib/audience.ts (eventWhereFor), роуты фильтр не копируют.
  // isInternal остаётся согласованно: isInternal = (audience == {staff});
  // удаление колонки — отдельный contract-релиз после DF-03.
  audience   String[] @default([])
  // DF-01: связь события с этапом/документом БЕЗ FK (как actorId —
  // история живёт дольше справочников, удаление цели не рвёт ленту).
  // stageId — для «кто тормозит» в Пульсе (DF-07), documentId — для
  // уведомлений о документах (DF-03) и пакета документов (DF-13).
  stageId    String?
  documentId String?

  order      Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contractor Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([leadId, createdAt])
  @@index([contractorId, createdAt])
}

// ─── З2: защита входа от перебора ──────────────────────────────
// Каждая попытка входа сотрудников и подрядчиков: провал сверки
// учётных данных (401) ИЛИ успех (аудит). Лимиты считает
// lib/login-guard.ts (скользящие окна): 5 провалов/мин и 20/час
// на IP, 10 провалов/5 мин на пару «логин + IP»; по одному логину —
// только замедление, без блокировки (E0-05).
// Новая таблица без ссылок на остальные — db:push не разрушающий.
model LoginAttempt {
  id        String   @id @default(cuid())
  // employee | contractor | client | broker — какой из четырёх входов
  // дёргали (в предыдущем проекте порталов было три, но различие в таблице он не
  // хранил; здесь храним — аудиту важно, какую дверь дёргали; Д
  // добавила четвёртую дверь)
  kind      String
  ip        String   @default("unknown")
  // Логин в нормализованном виде (+7XXXXXXXXXX). Nullable — на
  // случай будущего входа без логина (мастер-пароль в прошлом проекте).
  login     String?
  userAgent String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([login, createdAt])
  @@index([createdAt])
}

// ─── DF-00D: настройки системы (D32, инвариант 9) ──────────────
// Бизнес-параметры (окна рассылок, лимиты, пороги, часовой пояс,
// подписи) живут здесь, а не литералами в коде: владелец меняет их
// на экране /admin/settings без выката. Правило выбора места:
// секрет/адрес инфраструктуры → env; бизнес-параметр → эта таблица;
// перечень, с которым связана логика (виды документов, типы
// событий, статусы) → реестр в коде.
//
// key — стабильный код из реестра SETTINGS (src/lib/settings.ts);
// free-form ключи не допускаются: setSetting пишет только ключи
// реестра, значение проходит валидатор. value — Json: форма зависит
// от типа настройки (строка/число/массив), структуру знает
// реестр, БД не проверяет (валидация — TS-уровень, инвариант
// хелпера). Таблица МОЖЕТ БЫТЬ пустой: getSetting откатывается на
// значение по умолчанию — система работает и без неё (миграция
// expand-безопасна, старый код её не трогает).
//
// updatedByName — СНИМОК имени мастера (как actorName у Activity):
// без FK, справочник сотрудников живёт короче истории настроек,
// переименование не переписывает журнал. Факт изменения дублируется
// событием setting_changed (аудитория staff, старое/новое значение,
// без секретов) — единая точка записи emitEvent.
model Setting {
  key           String   @id
  value         Json
  updatedAt     DateTime @updatedAt
  updatedByName String
}

// ─── DF-03: очередь уведомлений и письма трёх режимов (D33) ──────────
// Единая очередь исходящих уведомлений: событие сделки (Activity) →
// правила матрицы §8 ROADMAP-DEALFLOW (lib/notifications/rules.ts) →
// строки очереди → диспетчер (lib/notifications/dispatch.ts) →
// транспорт (Resend HTTP API / fake / заглушки Telegram-WhatsApp).
// Очередь — ЖУРНАЛ: переживает удаление сделки и события, FK не имеет
// (паттерн actorId/Setting.updatedByName — ссылка живёт дольше цели).
//
// recipientKind: employee | client | broker ('contractor' зарезервирован
// и не используется, D31 — кабинет заморожен, подрядчик писем не
// получает). recipientId — id ЧЕЛОВЕКА-получателя: Employee.id либо
// CustomerUser/BrokerUser.id (адресат-человек, DF-02A); null — письмо
// на общий адрес компании (фолбэк recipientsOfCustomer/recipientsOfBroker).
//
// mode: immediate | regular | red (D33): immediate — согласование и
// события сотрудников, ≤ 5 минут; regular — перевозка, копится в окна
// notifications.client_digest_times (09:00/16:00 Europe/Moscow, не
// больше notifications.max_regular_per_day в сутки, пустого письма
// нет); red — вне окон и лимитов, антишторм 10-мин дедупликация +
// notifications.red_max_per_hour.
//
// status: pending | sent | failed | skipped (skipped = not_configured /
// not_allowlisted / no_email — целевое «не отправлено и не будет»).
// windowKey — окно regular-письма и дайджеста «yyyy-mm-dd:HH:MM»
// в поясе notifications.timezone; dedupKey @unique — защита от дублей
// (одиночные: type:kind:recipient:target:10-мин окно; дайджест:
// digest:kind:recipient:дата:окно) и от повторного прогона диспетчера.
//
// eventId — Activity.id без FK: событие может быть каскадно удалено
// вместе со сделкой, журнал отправок (DF-04) должен это пережить.
model Notification {
  id            String    @id @default(cuid())
  recipientKind String
  recipientId   String?
  // Снимок адреса на момент постановки в очередь: письмо уходит по адресу
  // из правила (адресат-человек либо фолбэк компании); смена email
  // получателем историю отправок не переписывает (паттерн actorName).
  toAddress     String
  channel       String    @default("email")
  mode          String
  eventId       String?
  type          String
  subject       String
  body          String
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  sentAt        DateTime?
  lastError     String?
  providerId    String?
  windowKey     String?
  dedupKey      String    @unique
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([recipientKind, recipientId, createdAt])
}

// Настройки доставки на получателя (карточка DF-03): по умолчанию
// email включён — строка может отсутствовать (отсутствие = включён).
// Управление preference'ами — следующий релиз (DF-04/личные кабинеты),
// модель и чтение правилами появляются здесь, чтобы не расширять
// схему дважды.
model NotificationPreference {
  id            String  @id @default(cuid())
  recipientKind String
  recipientId   String
  channel       String
  enabled       Boolean @default(true)

  @@unique([recipientKind, recipientId, channel])
}
