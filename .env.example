# ── Приложение ──────────────────────────────────────────────────────────────
# Подключение к PostgreSQL (например, Neon или локальный PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/logix?schema=public"

# ── Сид мастера (scripts/seed.ts, scripts/set-master-password.ts) ──────────
# Против НЕ-локальной базы сид отказывается создавать мастера без этих двух
# переменных: пароль по умолчанию в бою недопустим.
MASTER_PHONE="+79000000000"
MASTER_PASSWORD=" CHANGE_ME_strong_password "
# Алиасы для сид-скриптов (в бою задавать те же значения):
ADMIN_PHONE="+79000000000"
ADMIN_PASSWORD=" CHANGE_ME_strong_password "

# ── Режим разработки / эксплуатации ────────────────────────────────────────
# Разрешить --dev сид при локальном DATABASE_URL (localhost/127.0.0.1) —
# значения по умолчанию допустимы только там (см. seed.ts).
# TRUSTED_PROXY=1 — принимать X-Forwarded-For за обратным прокси (Vercel).
TRUSTED_PROXY=""
# База URL для e2e-прогона (scripts/e2e_api_test.py)
BASE_URL="http://localhost:3000"
# Платформенные переменные Vercel (задаёт платформа, локально пустые).
# VERCEL_ENV — окружение Vercel (production|preview|development): диспетчер
# DF-03 разрешает письма вне allowlist только в production (isProduction).
VERCEL_ENV=""
VERCEL=""
# VITEST — задаётся тест-раннером vitest сам; отключает автоматический
# scheduleDispatch в тестах (диспетчер зовётся явно). Вручную не ставить.
VITEST=""
VERCEL_GIT_COMMIT_SHA=""
# DISABLE_RATE_LIMIT=true — отключить rate-limit логина (только e2e-раннер;
# значение строго 'true' — см. src/lib/login-guard.ts).
DISABLE_RATE_LIMIT=""
# D31 (DF-00C): кабинет подрядчика заморожен. CONTRACTOR_PORTAL_ENABLED=true
# включает его (регресс/разморозка); без переменной все пути /contractor/**
# и /api/.../contractor/** отвечают 404 (см. docs/FROZEN.md и DEPLOY.md).
CONTRACTOR_PORTAL_ENABLED=""
# SHADOW_URL — только для scripts/shadow-db.ts (shadow-БД IC-01); задаётся
# integrity_check.py автоматически, вручную не нужно.

# ── DF-03: очередь уведомлений и письма (карточка DF-03) ───────────────────
# EMAIL_PROVIDER: none (по умолчанию — ничего не отправляется, статус
# skipped) | fake (e2e/CI: письмо считается доставленным, providerId=fake:<id>)
# | resend (боевой HTTP API Resend). Секреты и адрес — env, не настройки (D32):
#   RESEND_API_KEY — ключ API Resend (отдельный для Logix)
#   EMAIL_FROM     — адрес отправителя на поддомене домена владельца
#                    (рекомендация O-2: notify.fatyanov.com; DNS SPF/DKIM —
#                    см. RELEASE-INSTRUCTIONS)
#   APP_BASE_URL   — публичный адрес приложения для ссылок в письмах (D11)
#   CRON_SECRET    — Bearer-токен POST /api/internal/notifications/dispatch
#                    (внешний планировщик: workflow scheduler.yml ≥ 5 минут)
#   EMAIL_ALLOWLIST — адреса/домены через запятую; вне production письма
#                    уходят ТОЛЬКО на них, остальные — skipped:
#                    not_allowlisted. Формат: «a@b.ru, test.example»
#                    (домен = любой адрес на домене).
EMAIL_PROVIDER=""
RESEND_API_KEY=""
EMAIL_FROM=""
APP_BASE_URL=""
CRON_SECRET=""
EMAIL_ALLOWLIST=""

# ── DF-17: курсы ЦБ РФ (CurrencyRate, импорт проходом диспетчера) ──────────
# CBR_IMPORT: on (по умолчанию — импорт курсов проходом диспетчера раз в
# сутки, идемпотентен) | off (CI/e2e: без внешней сети, импорт
# короткое замыкание; см. lib/cbr.ts). Сбой импорта не валит проход
# диспетчера — расчёты берут последний известный курс с пометкой даты.
# CBR_RATE_URL — переопределение адреса выгрузки (по умолчанию
# https://www.cbr.ru/scripts/XML_daily.asp — источник и условия
# использования см. docs/REFERENCES-SOURCES.md). Обычно не задаётся.
CBR_IMPORT=""
CBR_RATE_URL=""
