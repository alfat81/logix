# ── Приложение ──────────────────────────────────────────────────────────────
# Подключение к PostgreSQL (например, Neon или локальный PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/logix?schema=public"

# ── Сид мастера (scripts/seed.ts, scripts/set-master-password.ts) ──────────
# Против НЕ-локальной базы сид отказывается создавать мастера без этих двух
# переменных: пароль по умолчанию в бою недопустим.
MASTER_PHONE="+79000000000"
MASTER_PASSWORD=" CHANGE_ME_strong_password "
# Алиасы для сид-скриптов (в бою задавать те же значения):
ADMIN_PHONE="+79000000000"
ADMIN_PASSWORD=" CHANGE_ME_strong_password "

# ── Режим разработки / эксплуатации ────────────────────────────────────────
# Разрешить --dev сид при локальном DATABASE_URL (localhost/127.0.0.1) —
# значения по умолчанию допустимы только там (см. seed.ts).
# TRUSTED_PROXY=1 — принимать X-Forwarded-For за обратным прокси (Vercel).
TRUSTED_PROXY=""
# База URL для e2e-прогона (scripts/e2e_api_test.py)
BASE_URL="http://localhost:3000"
# Платформенные переменные Vercel (задаёт платформа, локально пустые)
VERCEL=""
VERCEL_GIT_COMMIT_SHA=""
# DISABLE_RATE_LIMIT=1 — отключить rate-limit логина (только e2e-раннер).
DISABLE_RATE_LIMIT=""
# SHADOW_URL — только для scripts/shadow-db.ts (shadow-БД IC-01); задаётся
# integrity_check.py автоматически, вручную не нужно.
