# Neon Postgres — строка подключения
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Больше приложению переменных не нужно: аутентификация своя
# (scrypt + сессии в таблице EmployeeSession), NextAuth не используется.

# Seed (scripts/seed.ts) — мастер-учётка первого запуска.
# Для НЕ-локальной базы (PostgreSQL/Neon) ОБА значения ОБЯЗАТЕЛЬНЫ:
# сид откажется работать с паролем по умолчанию (З1).
# Локальный режим (SQLite file:... в DATABASE_URL или флаг --dev)
# без них создаёт +79000000000 / logix-master.
# MASTER_PHONE="+79001234567"
# MASTER_PASSWORD="change-me"
