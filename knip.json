{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,not-found,error}.ts*",
    "src/app/api/**/route.ts",
    "src/proxy.ts",
    "scripts/seed.ts",
    "scripts/set-master-password.ts",
    "scripts/shadow-db.ts",
    "scripts/backfill_waiting.ts",
    "scripts/e2e_backdate_waiting.ts",
    "src/lib/*.test.ts"
  ],
  "project": ["src/**/*.ts", "src/**/*.tsx", "scripts/*.ts", "scripts/ref-data/*.ts"],
  "ignoreDependencies": ["@types/bun", "tailwindcss", "tw-animate-css"],
  "ignoreExportsUsedInFile": true,
  "tags": ["-lint"]
}
